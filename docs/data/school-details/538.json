{"id":538,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"十五年一貫で確かな学力と人間力を育成","feature_description":"聖ウルスラ学院英智は、幼稚園から高校まで十五年間の一貫教育を行い、発達段階に応じて学習と生活のつまずきを減らしながら成長を支えます。キリスト教的人間観に基づく人格形成を目的に、言語技術、英語教育、ESDなど多彩な教育を展開します。学年段階を越えて基礎学力と自主学習の習慣を積み上げ、思考力・判断力・表現力を伸ばします。確かな学力と豊かな人間性を両立させることを重視しています。","clubs":[],"profile_sources":[{"id":1838,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=524","source_kind":"nichinoken","external_school_code":"524","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1839,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=524","source_kind":"nichinoken","external_school_code":"524","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1840,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=524","source_kind":"nichinoken","external_school_code":"524","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1841,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=524","source_kind":"nichinoken","external_school_code":"524","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3398,"attribute_key":"feature_summary","source_url":"https://www.st-ursula.ac.jp/junior/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3399,"attribute_key":"feature_description","source_url":"https://www.st-ursula.ac.jp/ju