{"id":103,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教主義と自由な校風のもとで行う全人教育","feature_description":"同志社中学校はキリスト教主義を教育の基本に置き、調和のとれた人間性、基礎学力、思考力と創造力、自主性・自治、国際性を育てます。教科センター方式や少人数授業、実験・実習など「ほんもの」に触れる学びを通じ、考える力・感じる力・表現する力を伸ばします。自由な校風のもと、生徒の知性と個性を育む中高一貫教育です。１クラス36人、英語は18人のハーフサイズで学びます。","clubs":[{"id":15306,"name":"サッカー部","category":"運動部","source_url":"https://jhs.js.doshisha.ac.jp/headline/real-madrid-school/","verified_at":"2026-11-20"}],"profile_sources":[{"id":2608,"attribute_key":"feature_summary","source_url":"https://jhs.js.doshisha.ac.jp/about/educationforallpeople/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2609,"attribute_key":"feature_description","source_url":"https://jhs.js.doshisha.ac.jp/about/educationforallpeople/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
