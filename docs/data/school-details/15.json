{"id":15,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自然と信仰の中で知性と人格を育む","feature_description":"ノートルダム清心中・高等学校は、広島市の小高い丘にあるカトリックのミッションスクールです。恵まれた自然環境の中で、豊かな人間性を育みながら知性を伸ばす教育を行っています。教育の特徴や学校生活を通じて、生徒一人ひとりが自分らしく学び、他者と関わりながら成長できる環境を整えている女子校です。公式サイトの紹介内容をもとにまとめています。","clubs":[],"profile_sources":[{"id":92,"attribute_key":"religious_background","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":93,"attribute_key":"dormitory_available","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":94,"attribute_key":"uniform_policy","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":95,"attribute_key":"affiliation_name","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":96,"attribute_key":"lunch_type","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":97,"attribute_key":"affiliation_type","source_url":"https://hiro-seishin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":98,"attribute_key":"high_school_progressi