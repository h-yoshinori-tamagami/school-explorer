{"id":537,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由・自律と国際感覚を育む羽衣の学び","feature_description":"羽衣学園は、愛真教育を基盤に、自由・自主・自律と個性尊重を掲げる人間教育を行います。基礎から応用までの授業、進路に応じたコース・科目選択に加え、地域・大学・海外の学校との連携や探究プロジェクトを展開します。英語教育と国際交流、ICT活用を通じて、論理的に考え自分の意見を伝える力を育成します。学習、行事、クラブ活動を横断して、協力し課題を解く力を磨きます。","clubs":[],"profile_sources":[{"id":1832,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=754","source_kind":"nichinoken","external_school_code":"754","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1833,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=754","source_kind":"nichinoken","external_school_code":"754","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1834,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=754","source_kind":"nichinoken","external_school_code":"754","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1835,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=754","source_kind":"nichinoken","external_school_code":"754","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1836,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=754","source_kind":"nichinoken","external_school_code":"754","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1837,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.j