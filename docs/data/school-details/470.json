{"id":470,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"ヒューマニズムで育つ清修の学び","feature_description":"白梅学園清修中高一貫部は、少人数の6年一貫教育を通して、ヒューマニズムの精神のもとで一人ひとりの才能や特徴を伸ばす学校です。学校生活では、エリアコラボレーションや鉄道模型デザイン班など独自の活動もあり、教科学習だけでは得にくい学びや体験を重ねられます。自分で考え、社会とつながる力を育てやすい環境です。落ち着いた女子校で自分の関心を深められます。","clubs":[],"profile_sources":[{"id":1612,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=296","source_kind":"nichinoken","external_school_code":"296","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1613,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=296","source_kind":"nichinoken","external_school_code":"296","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1614,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=296","source_kind":"nichinoken","external_school_code":"296","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1615,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=296","source_kind":"nichinoken","external_school_code":"296","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1616,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=296","source_kind":"nichinoken","external_school_code":"296","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1617,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np