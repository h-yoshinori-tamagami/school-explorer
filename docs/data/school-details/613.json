{"id":613,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自他共栄を基盤に挑戦する中高一貫教育","feature_description":"長崎日本大学は、自他共栄の精神を基盤に、学習・行事・部活動を通じた人間形成を目指す中高一貫校です。日々の授業で基礎学力を培い、仲間と協力して課題に取り組む経験を積み重ねます。多様な活動に主体的に参加し、自分の目標を定めて努力する姿勢を育てるとともに、互いを尊重し社会で役立つ力を身に付ける教育を行います。未来につながる学びを進めます。","clubs":[],"profile_sources":[{"id":2091,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=864","source_kind":"nichinoken","external_school_code":"864","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2092,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=864","source_kind":"nichinoken","external_school_code":"864","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2093,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=864","source_kind":"nichinoken","external_school_code":"864","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2094,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=864","source_kind":"nichinoken","external_school_code":"864","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2095,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=864","source_kind":"nichinoken","external_school_code":"864","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3548,"attribute_key":"feature_summary","source_url":"https://nagasaki-nichidai.jp/","source_kin