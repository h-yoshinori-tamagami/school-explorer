{"id":589,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"本物に触れるリベラルアーツと創造的探究の女子教育","feature_description":"跡見学園は、本物に触れるリベラルアーツを通じて、自律自立した女性を育てる学校です。美の探究や探究型の創造学習を重ね、知識を得るだけでなく、自分の感性や考えを表現する力を養います。多様なテーマに取り組み、仲間と協働して考える経験を通じて、社会に主体的に関わる姿勢を育みます。伝統的な学びと新しい探究を結び、未来を自分で選び取る力を伸ばします。","clubs":[],"profile_sources":[{"id":2013,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=128","source_kind":"nichinoken","external_school_code":"128","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2014,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=128","source_kind":"nichinoken","external_school_code":"128","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2015,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=128","source_kind":"nichinoken","external_school_code":"128","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2016,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=128","source_kind":"nichinoken","external_school_code":"128","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3500,"attribute_key":"feature_summary","source_url":"https://www.atomi.ac.jp/jh/about/philosophy/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3501,"attribute_key":"feature_description","source_url":"https://www.atomi.ac.jp/jh/about/philosophy/","