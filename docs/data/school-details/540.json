{"id":540,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"真理と対話を大切にするドミニコ教育","feature_description":"聖ドミニコ学園は、カトリックの聖人・聖ドミニコの教えを基盤に、「真理を求め、自由に生きる」ことを教育理念に掲げます。人を尊重して対話を重ね、その中で真理を探究する姿勢を大切にします。一人ひとりを神の愛に祝福されたかけがえのない存在と捉え、変化する社会で自分で考え、決断し、行動できる人を育てます。中高の一貫した学び合いの中で、思考と他者への思いやりを養う教育です。","clubs":[],"profile_sources":[{"id":1846,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=195","source_kind":"nichinoken","external_school_code":"195","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1847,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=195","source_kind":"nichinoken","external_school_code":"195","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1848,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=195","source_kind":"nichinoken","external_school_code":"195","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3402,"attribute_key":"feature_summary","source_url":"https://www.dominic.ed.jp/highschool/guide/policy/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3403,"attribute_key":"feature_description","source_url":"https://www.dominic.ed.jp/highschool/guide/policy/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
