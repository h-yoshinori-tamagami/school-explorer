{"id":303,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"誠を基本に個性を伸ばす一貫教育","feature_description":"早稲田中学校・高等学校は、誠を基本とする人格の養成と、個性の伸張を教育目標に掲げる学校です。6年間を通じて学力と人間的な成長を両立させ、教科の学び、学校行事、クラブ活動を一体で進めます。中高生が互いに刺激し合いながら、社会に貢献できる力を育てる姿勢が明確です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5412,"name":"陸上競技","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5413,"name":"サッカー","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5414,"name":"硬式庭球","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5415,"name":"ソフトテニス","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5416,"name":"硬式野球","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5417,"name":"軟式野球","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5418,"name":"バスケットボール","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5419,"name":"バレーボール","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5420,"name":"バドミントン","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5421,"name":"フェンシング","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5422,"name":"剣道","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":5423,"name":"弓道","category":"運動部","source_url":"https://www.waseda-h.ed.jp/life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":1066,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=207","source_kind":"nichinoken","external_school_c