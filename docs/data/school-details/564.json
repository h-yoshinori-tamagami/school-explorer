{"id":564,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究とキャリア教育で地域の未来を考える学校","feature_description":"下妻第一高等学校附属中学校は、高校生と附属中生が学習と部活動等を両立させる中高一貫の環境で学びます。総合的な学習では、企業・研究機関・県内附属中学校・大学との連携を生かし、実社会や生活の課題に探究的に取り組みます。キャリア探究授業では、生徒が自らの夢を起点に将来を考える機会も設けています。主体的に課題を発見・解決し、地域や社会と関わる学びを大切にする学校です。","clubs":[{"id":10655,"name":"女子バレーボール部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10656,"name":"剣道部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10657,"name":"陸上競技部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10658,"name":"水泳部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10659,"name":"女子テニス部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10660,"name":"サッカー部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"},{"id":10661,"name":"柔道部","category":"運動部","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/page_20230613222905","verified_at":"2026-08-10"}],"profile_sources":[{"id":3450,"attribute_key":"feature_summary","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/%E5%AD%A6%E6%A0%A1%E7%B4%B9%E4%BB%8B1","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3451,"attribute_key":"feature_description","source_url":"https://www.shimotsuma1-jh.ibk.ed.jp/%E5%AD%A6%E6%A0%A1%E7%B4%B9%E4%BB%8B1","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
