{"id":47,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"仏教精神と知性で社会へ貢献する女子教育","feature_description":"京都女子中学校・高等学校は、仏教精神に基づき、知性と豊かな心を備えた女性の育成を目指す女子校です。中高一貫の学びを通じて基礎学力を固め、探究、国際理解、学校行事、部活動を通して主体性と協働性を伸ばします。自分を見つめ、他者や社会のために力を生かす姿勢を大切にしています。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":354,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=624","source_kind":"nichinoken","external_school_code":"624","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":355,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=624","source_kind":"nichinoken","external_school_code":"624","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":356,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=624","source_kind":"nichinoken","external_school_code":"624","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":357,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=624","source_kind":"nichinoken","external_school_code":"624","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":358,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=624","source_kind":"nichinoken","external_school_code":"624","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":359,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw