{"id":302,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"高大一貫で知性と人間性を育てる","feature_description":"早稲田大学高等学院は、高・大一貫教育のもとで健康と知性、豊かな人間形成を目指す学校です。独自の教育課程で知的好奇心を伸ばし、第二外国語、情報教育、探究を通して、将来の専門的な学びに必要な基礎を育てます。課外活動も充実し、学習と学校生活を両立しやすい構成です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5402,"name":"ボート部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5403,"name":"ラグビー部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5404,"name":"サッカー部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5405,"name":"バレーボール部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5406,"name":"バスケットボール部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5407,"name":"硬式野球部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5408,"name":"水泳部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5409,"name":"卓球部","category":"運動部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5410,"name":"吹奏楽部","category":"文化部","source_url":"https://www.waseda.jp/school/shs/campus","verified_at":"2026-08-06"},{"id":5411,"name":"グリークラブ","category":"文化部","source_url":"https://www.waseda.jp/school/shs/campus/glee","verified_at":"2026-08-06"}],"profile_sources":[{"id":1060,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=299","source_kind":"nichinoken","external_school_code":"299","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1061,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.c