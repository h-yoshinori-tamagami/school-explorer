{"id":302,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"大学までの接続を見据えた中学教育","feature_description":"早稲田大学高等学院中学部は、高等学院や大学へつながる前期中等教育を行う男子校です。数学では課題を見つけ論理的に考える力を育て、理科では実験や観察を通した主体的な学びを重視します。英語は四技能の基礎に加え、スピーチなどで表現する機会を設けています。社会では地理・歴史・公民を学び、校外学習や宿泊研修も行います。学校行事や課外活動にも取り組みます。","clubs":[{"id":5404,"name":"サッカー部","category":"運動部","source_url":"https://www.waseda.jp/school/jhs/campus/","verified_at":"2026-11-11"},{"id":5405,"name":"バレーボール部","category":"運動部","source_url":"https://www.waseda.jp/school/jhs/campus/","verified_at":"2026-11-11"},{"id":5406,"name":"バスケットボール部","category":"運動部","source_url":"https://www.waseda.jp/school/jhs/campus/","verified_at":"2026-11-11"},{"id":5410,"name":"吹奏楽部","category":"文化部","source_url":"https://www.waseda.jp/school/jhs/campus/","verified_at":"2026-11-11"}],"profile_sources":[{"id":1060,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=299","source_kind":"nichinoken","external_school_code":"299","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1061,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=299","source_kind":"nichinoken","external_school_code":"299","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1062,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=299","source_kind":"nichinoken","external_school_code":"299","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1063,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=299","source_kind":"nichinoken","external_school_code":"299","verified_at":"2026-08-04","sou