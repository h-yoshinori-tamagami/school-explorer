{"id":38,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数と英語で未来へ挑む中高一貫教育","feature_description":"九州国際大学付属中学校は、少人数教育を生かして基礎学力と表現力を丁寧に伸ばす中高一貫校です。英語教育、探究的な学び、学校行事を通して、自分の考えを伝え、仲間と協働する力を育てます。大学付属校として進路意識を早い段階から高め、将来の目標に向かって挑戦する姿勢を支えています。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[{"id":555,"name":"男子サッカー","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":556,"name":"野球","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":557,"name":"陸上競技","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":558,"name":"ソフトテニス","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":559,"name":"バドミントン","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":560,"name":"剣道","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":561,"name":"女子バレーボール","category":"運動部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":562,"name":"吹奏楽","category":"文化部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":563,"name":"放送","category":"文化部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"},{"id":564,"name":"インターアクト","category":"文化部","source_url":"https://959j.kif.ed.jp/junior-life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":310,"attribute_key":"religious_background","source_url":"https://www.kiu-h.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":311,"attribute_key":"dormitory_available","source_url":"https://www.kiu-h.ed.jp/","source_kind":"official_site","external_school_code":null,