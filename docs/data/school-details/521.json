{"id":521,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由と探究で世界に挑む立命館慶祥","feature_description":"立命館慶祥は、建学の精神『自由と清新』と教学理念『平和と民主主義』のもと、『世界に通用する18歳』を掲げる中高一貫校です。SPコースを含む学びでは、本物に触れ、本物を体験する姿勢を大切にし、国際感覚と課題解決力を伸ばします。学校生活全体で主体性と挑戦心を育てるのが特徴です。探究と英語を軸に、自分で道を選ぶ力も磨けます。","clubs":[{"id":10238,"name":"中学サッカー部","category":"運動部","source_url":"https://www2.spc.ritsumei.ac.jp/03_menu_jhs/SP_03_4_1_club_jhs_football.html","verified_at":"2026-08-07"},{"id":10239,"name":"中学吹奏楽部","category":"文化部","source_url":"https://www2.spc.ritsumei.ac.jp/03_menu_jhs/SP_03_4_1_club_jhs_suisougaku.html","verified_at":"2026-08-07"},{"id":10240,"name":"中学演劇部","category":"文化部","source_url":"https://www2.spc.ritsumei.ac.jp/03_menu_jhs/SP_03_4_1_club_jhs_engeki.html","verified_at":"2026-08-07"},{"id":10241,"name":"中学競技かるた部","category":"文化部","source_url":"https://www2.spc.ritsumei.ac.jp/03_menu_jhs/SP_03_4_1_club_jhs_karuta.html","verified_at":"2026-08-07"},{"id":10242,"name":"高校演劇部","category":"文化部","source_url":"https://www2.spc.ritsumei.ac.jp/04_menu_hs/SP_04_4_1_club_hs_engeki.html","verified_at":"2026-08-07"},{"id":10243,"name":"高校バドミントン部","category":"運動部","source_url":"https://www2.spc.ritsumei.ac.jp/04_menu_hs/SP_04_4_1_club_hs_badminton.html","verified_at":"2026-08-07"},{"id":10244,"name":"高校競技かるた部","category":"文化部","source_url":"https://www2.spc.ritsumei.ac.jp/04_menu_hs/SP_04_4_1_club_hs_karuta.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":1767,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=511","source_kind":"nichinoken","external_school_code":"511","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1768,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=511","source_kind":"nichinoken","external_school_code":"511","verified_at":"2026-08-05",