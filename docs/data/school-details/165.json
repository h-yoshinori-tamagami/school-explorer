{"id":165,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"アシステンツァで育つ大阪星光学院","feature_description":"大阪星光学院は、「アシステンツァ（ともにいる）」を教育姿勢に掲げ、生徒と教職員が同じ時間を重ねながら信頼関係を築く学校です。クラブ活動では体育系12、文化系21のクラブや同好会があり、中学・高校ともに多くの生徒が参加しています。 クラブ活動一覧も整っており、生徒が学年を越えて活動しやすい土台が見えます。 宗教的な落ち着きと部活動の活気が両立している点も特徴です。 参加率の高さが、学院全体の一体感にもつながっています。","clubs":[{"id":2951,"name":"けん玉同好会","category":"同好会・愛好会","source_url":"https://www.osakaseiko.ac.jp/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":705,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=709","source_kind":"nichinoken","external_school_code":"709","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":706,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=709","source_kind":"nichinoken","external_school_code":"709","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":707,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=709","source_kind":"nichinoken","external_school_code":"709","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":708,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=709","source_kind":"nichinoken","external_school_code":"709","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":709,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=709","source_kind":"nichinoken","external_school_code":"709","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":nul