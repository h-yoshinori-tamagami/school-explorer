{"id":542,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"感謝と奉仕を育むヨゼフの一貫教育","feature_description":"聖ヨゼフ学園は、才能や個性に気づき、それを伸ばして社会に奉仕する人を育てる中高一貫の女子校です。和解と一致を目指す精神を大切にし、信頼に基づくコミュニケーションを多様な活動を通じて学びます。中学では国際バカロレアMYPの考え方を生かし、教科を横断して実社会とのつながりを探究します。高校では進路に応じたコースと少人数指導を整え、英語・国語の言語教育、発信型・プロジェクト型の学びを進めています。","clubs":[{"id":10481,"name":"演劇部","category":"文化部","source_url":"https://www.st-joseph.ac.jp/high/school_life/club.php","verified_at":"2026-08-08"},{"id":10482,"name":"ESS","category":"文化部","source_url":"https://www.st-joseph.ac.jp/high/school_life/club.php","verified_at":"2026-08-08"},{"id":10483,"name":"弦楽部","category":"文化部","source_url":"https://www.st-joseph.ac.jp/high/school_life/club.php","verified_at":"2026-08-08"},{"id":10484,"name":"卓球部","category":"運動部","source_url":"https://www.st-joseph.ac.jp/high/school_life/club.php","verified_at":"2026-08-08"},{"id":10485,"name":"バレーボール部","category":"運動部","source_url":"https://www.st-joseph.ac.jp/high/school_life/club.php","verified_at":"2026-08-08"}],"profile_sources":[{"id":1854,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=323","source_kind":"nichinoken","external_school_code":"323","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1855,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=323","source_kind":"nichinoken","external_school_code":"323","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1856,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=323","source_kind":"nichinoken","external_school_code":"323","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":