{"id":51,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"感性と個性を伸ばす附属中高一貫教育","feature_description":"京都教育大学附属桃山中学校は、京都教育大学の附属学校として、公教育の推進、教育実習、教育研究の役割を担う学校です。校訓に「豊かな感性・輝く個性・拡がる共生」を掲げ、周囲と関わりながら自己を伸ばす生徒の育成を目指します。探究的な授業や生徒主体の行事を通して、主体的に学び協働する力を育てます。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":642,"name":"女子ソフトテニス部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":643,"name":"男子ソフトテニス部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":644,"name":"女子バレーボール部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":645,"name":"男子バレーボール部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":646,"name":"女子バスケットボール部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":647,"name":"サッカー部","category":"運動部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":648,"name":"ICT部","category":"文化部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":649,"name":"音楽部","category":"文化部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":650,"name":"科学部","category":"文化部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":651,"name":"家庭部","category":"文化部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"},{"id":652,"name":"美術部","category":"文化部","source_url":"https://momochu.kyokyo-u.ac.jp/content/","verified_at":"2026-08-06"}],"profile_sources":[{"id":361,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=939","source_kind":"nichinoken","external_school_code":"939","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_ha