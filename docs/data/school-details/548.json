{"id":548,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"六年一貫と探究で育む豊かな人間性","feature_description":"聖心学園中等教育学校は、知識の習得にとどまらず豊かな人間性を育むことを重視する完全六年一貫校です。前期課程では学ぶ姿勢と基礎学力を築き、後期課程で応用から完成へ進む学力向上システムを整えています。グローバル教育では英語集中プログラムや海外修学旅行、語学研修を通じて英語力を高めます。生徒は主体的に課題へ向き合い、問題の発見と解決策の提案を繰り返す探究学習にも取り組みます。","clubs":[{"id":10511,"name":"バドミントン部","category":"運動部","source_url":"https://www.seishingakuenchuto.ed.jp/school_life/club/","verified_at":"2026-08-08"},{"id":10512,"name":"創作ダンス部","category":"運動部","source_url":"https://www.seishingakuenchuto.ed.jp/school_life/club/","verified_at":"2026-08-08"},{"id":10513,"name":"筝曲部","category":"文化部","source_url":"https://www.seishingakuenchuto.ed.jp/school_life/club/","verified_at":"2026-08-08"},{"id":10514,"name":"グローバルカルチャークラブ","category":"文化部","source_url":"https://www.seishingakuenchuto.ed.jp/school_life/club/","verified_at":"2026-08-08"},{"id":10515,"name":"鉄道研究会","category":"同好会・愛好会","source_url":"https://www.seishingakuenchuto.ed.jp/school_life/club/","verified_at":"2026-08-08"}],"profile_sources":[{"id":1870,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=600","source_kind":"nichinoken","external_school_code":"600","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1871,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=600","source_kind":"nichinoken","external_school_code":"600","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1872,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=600","source_kind":"nichinoken","external_school_code":"600","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null