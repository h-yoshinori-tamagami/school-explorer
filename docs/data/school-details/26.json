{"id":26,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"イエズス会の精神で奉仕する人を育む","feature_description":"上智福岡中学高等学校は、カトリックのイエズス会教育を基盤に、学力だけでなく人格形成を重視する学校です。他者への奉仕、誠実さ、広い視野を大切にし、日々の学習や学校生活を通じて自分の力を社会のために生かす姿勢を育てます。上智大学と同じ教育精神に連なる中高一貫校として、生徒の知性と心の成長を支えています。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":194,"attribute_key":"religious_background","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":195,"attribute_key":"dormitory_available","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":196,"attribute_key":"uniform_policy","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":197,"attribute_key":"affiliation_name","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":198,"attribute_key":"lunch_type","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":199,"attribute_key":"affiliation_type","source_url":"https://www.sophias.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":200,"attribute_key":"high_scho