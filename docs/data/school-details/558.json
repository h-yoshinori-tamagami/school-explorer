{"id":558,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"学校教育目標を軸に学び合う市立中学校教育","feature_description":"千葉市立花園中学校は、学校教育目標を学校経営の中心に置き、日々の授業、学校行事、生徒会や部活動などの学校生活を通じて教育活動を進めています。公式サイトでは、年間計画、生活のきまり、学校評価、いじめ防止基本方針・指導計画を公開し、生徒・保護者・地域に向けた情報を整備しています。学年や学校生活に関する情報を共有しながら、地域の市立中学校として継続的な学びと生活の基盤を支える学校です。","clubs":[{"id":10592,"name":"野球部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10593,"name":"サッカー部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10594,"name":"ハンドボール部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10595,"name":"陸上競技部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10596,"name":"バドミントン部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10597,"name":"ソフトテニス部","category":"運動部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_05.pdf","verified_at":"2026-08-10"},{"id":10598,"name":"吹奏楽部","category":"文化部","source_url":"https://www.city.chiba.jp/school/jhs/007/gakkoshokai/documents/gakkoudayori_13.pdf","verified_at":"2026-08-10"}],"profile_sources":[{"id":1912,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=650","source_kind":"nichinoken","external_school_code":"650","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1913,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=650","sou