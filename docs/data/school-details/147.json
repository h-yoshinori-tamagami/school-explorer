{"id":147,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"学習と課外活動を育む大妻中高の魅力","feature_description":"大妻中学高等学校は、教育理念や大妻の教育、学校生活、進路指導を分かりやすく整理し、クラブ・同好会や委員会の情報へ自然につながる導線を備えています。学校案内と学校生活が一体で、日常と進路の両面を読み取りやすい公式サイトです。 委員会や進路学習の導線も近く、学校生活全体を見渡しながら部活動の位置づけを把握できます。 学校案内と学校生活の距離が近く、日々の活動を立体的に見られます。","clubs":[{"id":2206,"name":"バレーボール部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2207,"name":"バスケットボール部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2208,"name":"ソフトテニス部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2209,"name":"卓球部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2210,"name":"ダンス部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2211,"name":"ワンダーフォーゲル部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2212,"name":"体操部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2213,"name":"バトン部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2214,"name":"剣道部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"},{"id":2215,"name":"陸上部","category":"運動部","source_url":"https://www.otsuma.ed.jp/schoollife/athletic/","verified_at":"2026-08-06"}],"profile_sources":[{"id":653,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=104","source_kind":"nichinoken","external_school_code":"104","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":654