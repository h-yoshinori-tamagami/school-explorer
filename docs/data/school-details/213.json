{"id":213,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"5+1年で学力を伸ばす岐阜東中高","feature_description":"岐阜東中学校は、中高一貫の特色を生かし、2年間で中学内容を修了し、6年生で受験指導に集中する『5+1』の学びを進めています。英会話、オンライン英会話、体験学習、芸術鑑賞、読書の時間などを組み合わせ、個別指導と課題学習を徹底する方針が公式に示されています。国際感覚を育てる設計も明確で、学校生活と行事の導線も分かり、個別の伴走も丁寧です。","clubs":[],"profile_sources":[{"id":834,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=579","source_kind":"nichinoken","external_school_code":"579","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":835,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=579","source_kind":"nichinoken","external_school_code":"579","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":836,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=579","source_kind":"nichinoken","external_school_code":"579","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":837,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=579","source_kind":"nichinoken","external_school_code":"579","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":838,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=579","source_kind":"nichinoken","external_school_code":"579","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":839,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolin