{"id":436,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"カトリックと体験で育む人間教育","feature_description":"ノートルダム清心中・高等学校は、カトリック教育を基盤に、一人ひとりを大切にし、感謝・支え合い・奉仕の心を育てます。宗教の授業や行事、ボランティア活動を通じて他者や社会との関わりを考える機会を設けています。学校生活では学年ごとの宿泊研修、平和学習、学習合宿、芸術・体育行事などを行い、仲間との経験を通して学びを深めます。その経験を大切にします。","clubs":[],"profile_sources":[{"id":3692,"attribute_key":"feature_summary","source_url":"https://www.hiro-seishin.ed.jp/schoollife/school-year/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-15","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3693,"attribute_key":"feature_description","source_url":"https://www.hiro-seishin.ed.jp/schoollife/school-year/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-15","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
