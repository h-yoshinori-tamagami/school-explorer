{"id":310,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"質実剛毅と協同自治で育つ明大中野","feature_description":"明治大学付属中野中学・高等学校は、『質実剛毅・協同自治』の校訓のもと、知・徳・体を育てる一貫教育を行う学校です。勉強だけに偏らず、学校行事や特別活動、部活動を通して生徒の個性を伸ばし、長期的な視点で学力と主体性を育てます。明治大学との連携も明確です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5465,"name":"アーチェリー部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5466,"name":"応援部","category":"文化部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5467,"name":"剣道部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5468,"name":"ゴルフ部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5469,"name":"高校サッカー部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5470,"name":"中学サッカー部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5471,"name":"山岳部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":5472,"name":"射撃部","category":"運動部","source_url":"https://www.nakanogakuen.ac.jp/schoollife/club.html","verified_at":"2026-08-06"}],"profile_sources":[{"id":1092,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=213","source_kind":"nichinoken","external_school_code":"213","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1093,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=213","source_kind":"nichinoken","external_school_code":"213","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":nul