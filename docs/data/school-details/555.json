{"id":555,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"SSHの探究と科学力で社会課題に向き合う学び","feature_description":"芝浦工業大学柏中学校は、生涯にわたり学び続ける力を育てることを掲げ、探究教育、理数教育、キャリア教育、ICT教育、グローバル教育を展開します。SSHの教育では、自律的活動力、問題発見力、問題解決力、研究基礎力からなるSSコンピテンシーを育成目標に設定しています。精選した学習と探究的な学びを組み合わせ、社会課題に自ら問いを立て、他者と協働して解決へ向かう力を養います。","clubs":[{"id":10571,"name":"野球部","category":"運動部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10572,"name":"サッカー部","category":"運動部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10573,"name":"水泳部（競泳・水球）","category":"運動部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10574,"name":"ソフトテニス部","category":"運動部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10575,"name":"科学部","category":"文化部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10576,"name":"コンピューター部","category":"文化部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"},{"id":10577,"name":"鉄道研究部","category":"文化部","source_url":"https://www.ka.shibaura-it.ac.jp/schoollife/club/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1894,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=423","source_kind":"nichinoken","external_school_code":"423","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1895,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=423","source_kind":"nichinoken","external_school_code":"423","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1896,"attribute_key":"lunch_type","source_url":"h