{"id":48,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"エンプラで未来社会を切り拓く力を育む","feature_description":"京都市立西京高等学校附属中学校は、中高一貫教育の中で、エンタープライジングな精神を育てることを特色としています。探究、英語、理数、社会と関わる学びを通して、自ら課題を見つけ、仲間と協働し、解決に向けて行動する力を養います。将来、社会に新しい価値を生み出す人材を目指す学校です。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":2428,"attribute_key":"feature_summary","source_url":"https://cms.edu.city.kyoto.jp/weblog/index.php?id=108602","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2429,"attribute_key":"feature_description","source_url":"https://cms.edu.city.kyoto.jp/weblog/index.php?id=108602","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
