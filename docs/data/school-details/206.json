{"id":206,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"進学国際生き方で育てる尚絅学院","feature_description":"尚絅学院中学校は、進学教育、国際教育、生き方教育の三つを柱にした6年間一貫教育を掲げています。少人数で一人ひとりに向き合いながら、キリスト教主義の人間教育を土台に、能力と個性を伸ばす方針が公式の学校案内で示されています。探究学習や高大連携の流れも確認できます。礼拝や行事も学校生活に組み込まれており、落ち着いた学びの土台が整えられています。","clubs":[{"id":4571,"name":"女子バドミントン部","category":"運動部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4572,"name":"男子バドミントン部","category":"運動部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4573,"name":"陸上部","category":"運動部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4574,"name":"剣道部","category":"運動部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4575,"name":"宗教部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4576,"name":"管弦楽部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4577,"name":"合唱部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4578,"name":"演劇部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4579,"name":"美術部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4580,"name":"書道部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"},{"id":4581,"name":"茶道部","category":"文化部","source_url":"https://sh.shokei.jp/jhs/schoollife/club.php","verified_at":"2026-08-06"}],"profile_sources":[{"id":2844,"attribute_key":"feature_summary","source_url":"https://sh.shokei.jp/jhs/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":n