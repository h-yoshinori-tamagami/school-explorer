{"id":541,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教と英語で世界へ羽ばたく学び","feature_description":"聖マリア女学院は、聖書を基盤とする情操教育を通して、自己と向き合い他者を思いやる心と品格を育てる女子校です。ネイティブ教員とのチームティーチング、英語漬けの宿泊行事、海外研修や留学支援を用意し、生きた語学力と国際感覚を磨きます。英語・数学では習熟度別少人数授業も行い、基礎の定着から発展的な学習まで一人ひとりを支えます。福祉活動やピア・サポートにも取り組み、学びを他者のために生かす姿勢を大切にしています。","clubs":[{"id":10476,"name":"アーチェリー","category":"運動部","source_url":"https://maria.ed.jp/schoollife/","verified_at":"2026-08-08"},{"id":10477,"name":"バレーボール","category":"運動部","source_url":"https://maria.ed.jp/schoollife/","verified_at":"2026-08-08"},{"id":10478,"name":"ダンス","category":"運動部","source_url":"https://maria.ed.jp/schoollife/","verified_at":"2026-08-08"},{"id":10479,"name":"英語ディベート","category":"文化部","source_url":"https://maria.ed.jp/schoollife/","verified_at":"2026-08-08"},{"id":10480,"name":"吹奏楽","category":"文化部","source_url":"https://maria.ed.jp/schoollife/","verified_at":"2026-08-08"}],"profile_sources":[{"id":1849,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=580","source_kind":"nichinoken","external_school_code":"580","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1850,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=580","source_kind":"nichinoken","external_school_code":"580","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1851,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=580","source_kind":"nichinoken","external_school_code":"580","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1852,"attribute_key":"international_programs","source_url":"https://www.nichinoken.c