{"id":328,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"誠実明朗で能力を伸ばす和歌山校","feature_description":"智辯学園和歌山中学校・高等学校は、『誠実・明朗』を教育目標に、持てる能力の最大開発をめざす学校です。人や物を大切にする心、感謝の心、使命感を育てる方針が明示され、建学の精神を継承しながら中高一貫の学びを進めています。教育目標が明快で比較しやすいです。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5636,"name":"野球部","category":"運動部","source_url":"https://www.chiben.ac.jp/wakayama/about/sports/","verified_at":"2026-08-06"},{"id":5637,"name":"陸上部","category":"運動部","source_url":"https://www.chiben.ac.jp/wakayama/about/sports/","verified_at":"2026-08-06"}],"profile_sources":[{"id":1154,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1155,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1156,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1157,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2966,"attribute_key":"feature_summary","source_url":"https://www.chiben.ac.jp/wakayama/about/","source_kind":"official_site","external_sch