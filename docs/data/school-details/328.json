{"id":328,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"誠実・明朗と能力の最大開発を目指す中高一貫校","feature_description":"智辯学園和歌山は「誠実・明朗」を教育目標に、愛情をもって生徒一人ひとりを支え、能力の最大開発を目指します。中高６年一貫コースでは、中学２年までに中学内容を終え、中学３年から高校内容を学習。英語・数学・国語の基礎を重視し、60分授業や十分な授業時間を通じて体系的な思考力を育てます。日々の補習や長期休暇中の課題も用意し、授業と家庭学習を支援しています。","clubs":[],"profile_sources":[{"id":1154,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1155,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1156,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1157,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=648","source_kind":"nichinoken","external_school_code":"648","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2966,"attribute_key":"feature_summary","source_url":"https://www.chiben.ac.jp/wakayama/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2967,"attribute_key":"feature_description","source_url":"https://www.chiben.ac.jp/wakayama/about/","sour