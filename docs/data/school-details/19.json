{"id":19,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"感恩奉仕の精神で社会に貢献する学び","feature_description":"ルーテル学院中学・高等学校は、建学の精神である「感恩奉仕」を学院標語に掲げる中高一貫校です。自分を支えるすべてのものへの感謝、他者を尊重する心、奉仕を通じた社会への貢献を大切にしています。学びや学校生活を通して、自らの成長を周囲や社会のために生かせる人へ育つことを目指しています。公式サイトの紹介内容をもとにまとめています。","clubs":[],"profile_sources":[{"id":130,"attribute_key":"religious_background","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":131,"attribute_key":"dormitory_available","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":132,"attribute_key":"uniform_policy","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":133,"attribute_key":"lunch_type","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":134,"attribute_key":"high_school_progression","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":135,"attribute_key":"scholarship_system","source_url":"https://www.luther.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":136,"attribute_key":"international_progra