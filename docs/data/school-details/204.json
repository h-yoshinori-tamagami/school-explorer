{"id":204,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"魂を育てる小林聖心女子学院の学び","feature_description":"小林聖心女子学院は、『魂を育てる』『知性を磨く』『実行力を養う』という3つの教育方針を掲げています。祈りや奉仕活動、授業、行事の企画運営を通して、物事の背景まで考え、多角的に捉える力を育てる姿勢が公式サイトで示されています。宗教教育、英語教育、国際理解教育、ICT教育に加え、12年一貫の学びとして成長を継続的に支える点も確認できます。","clubs":[{"id":4559,"name":"アウトドア","category":"運動部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4560,"name":"創作手芸","category":"文化部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4561,"name":"プログラミング","category":"文化部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4562,"name":"チャレンジ科学","category":"文化部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4563,"name":"ミニバスケットボール","category":"運動部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4564,"name":"卓球","category":"運動部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"},{"id":4565,"name":"ドッジボール","category":"運動部","source_url":"https://www.oby-sacred-heart.ed.jp/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":802,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=784","source_kind":"nichinoken","external_school_code":"784","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":803,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=784","source_kind":"nichinoken","external_school_code":"784","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":804,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=784","source_kind":"nich