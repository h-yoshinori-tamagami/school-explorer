{"id":682,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際社会で発信し行動する力を育てる","feature_description":"千葉市立稲毛国際中等教育学校は、国際社会の一員として考えを発信し、自ら行動できる人を育てることを教育目標に掲げています。確かな学力、他者を尊重する心、調和のとれた体力を養い、一人ひとりが自分のあり方を見つけることも支えます。授業では主体的に学ぶ姿勢と対話を重視し、知的好奇心を引き出しながら、身に付けた知識を生活や社会に生かす力につなげます。","clubs":[{"id":15327,"name":"剣道部","category":"運動部","source_url":"https://www.city.chiba.jp/school/hs/001/documents/documents/kenndoubu.pdf","verified_at":"2026-11-20"},{"id":15328,"name":"卓球部","category":"運動部","source_url":"https://www.city.chiba.jp/school/hs/001/documents/documents/r7tabletennis-jhh.pdf","verified_at":"2026-11-20"},{"id":15329,"name":"陸上競技部","category":"運動部","source_url":"https://www.city.chiba.jp/school/hs/001/documents/documents/rikuzyoukyougi_zenki.pdf","verified_at":"2026-11-20"},{"id":15330,"name":"オーケストラ部","category":"文化部","source_url":"https://www.city.chiba.jp/school/hs/001/documents/documents/okesutorabu.pdf","verified_at":"2026-11-20"}],"profile_sources":[{"id":3809,"attribute_key":"feature_summary","source_url":"https://www.city.chiba.jp/school/hs/001/kyoikumokuhyo.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3810,"attribute_key":"feature_description","source_url":"https://www.city.chiba.jp/school/hs/001/kyoikumokuhyo.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3819,"attribute_key":"lunch_type","source_url":"https://www.city.chiba.jp/school/hs/001/gakkoshokai/faq.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
