{"id":22,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"徳才兼備とつながる力を育む女子教育","feature_description":"三輪田学園中学校・高等学校は、誠実で、だれとでもつながることができ、自らの人生を切り拓いて生きる女性の育成を掲げています。徳と才能を兼ね備える「徳才兼備」を大切にし、知識や技能だけでなく、人との関わりの中で成長する力を育てます。都心の複数駅から通いやすい立地も学校生活を支える特徴です。公式サイトの紹介内容をもとにまとめています。","clubs":[],"profile_sources":[{"id":155,"attribute_key":"religious_background","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":156,"attribute_key":"dormitory_available","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":157,"attribute_key":"uniform_policy","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":158,"attribute_key":"affiliation_name","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":159,"attribute_key":"lunch_type","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":160,"attribute_key":"affiliation_type","source_url":"https://www.miwada.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":161,"attribute_key":"high_school_progression","