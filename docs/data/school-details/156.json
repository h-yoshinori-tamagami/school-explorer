{"id":156,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"あたたかさで伸ばす大阪信愛学院","feature_description":"大阪信愛学院中学校は、キリスト教に根ざした教育と「一人ひとりを大切にする教育」を軸に、あたたかい校風の中で学びを進める学校です。6限中心の学際コースでは学習とクラブ活動の両立も意識され、校内で学びのすべてを完結できる設計が特徴です。 ゴルフ部や軟式野球部の新しい挑戦もあり、学校全体で活動の幅が広がっています。 校内完結型の学びなので、毎日の生活リズムも整えやすいです。 保護者にも学校生活の見通しが立てやすい案内になっています。","clubs":[{"id":2948,"name":"ゴルフ部","category":"運動部","source_url":"https://junior.osaka-shinai.ed.jp/club/","verified_at":"2026-08-06"},{"id":2949,"name":"軟式野球部","category":"運動部","source_url":"https://junior.osaka-shinai.ed.jp/club/","verified_at":"2026-08-06"},{"id":2950,"name":"卓球部","category":"運動部","source_url":"https://junior.osaka-shinai.ed.jp/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":682,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=702","source_kind":"nichinoken","external_school_code":"702","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":683,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=702","source_kind":"nichinoken","external_school_code":"702","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":684,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=702","source_kind":"nichinoken","external_school_code":"702","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":685,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=702","source_kind":"nichinoken","external_school_code":"702","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null