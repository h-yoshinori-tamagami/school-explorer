{"id":506,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"6年を見通す嘉穂附属の育徳教育","feature_description":"嘉穂高等学校附属中学校は、校訓『育徳 さわやかに 心ゆたかに ひたむきに』のもと、6年間を見通した進路指導で一人ひとりの夢の実現をめざしています。学校生活では、総合運動部や個別の部活動の活動計画が公開され、早期入部制度も案内されています。学習と活動の両輪で生徒を支える学校像が公式サイトから伝わります。学びの幅と学校生活の厚みを感じやすいです。","clubs":[{"id":9977,"name":"総合運動部","category":"運動部","source_url":"https://kaho-j.fku.ed.jp/gakkouseikatu/club/","verified_at":"2026-08-07"},{"id":9978,"name":"剣道部","category":"運動部","source_url":"https://kaho-j.fku.ed.jp/wp-content/uploads/kaho_j/2026/07/09080759/運動部R8★活動実績-4-6月.pdf","verified_at":"2026-08-07"},{"id":9979,"name":"柔道部","category":"運動部","source_url":"https://kaho-j.fku.ed.jp/wp-content/uploads/kaho_j/2026/07/09080759/運動部R8★活動実績-4-6月.pdf","verified_at":"2026-08-07"},{"id":9980,"name":"吹奏楽部","category":"文化部","source_url":"https://kaho-j.fku.ed.jp/wp-content/uploads/kaho_j/2026/07/09080822/文化部-R8★活動実績-4-6月.pdf","verified_at":"2026-08-07"},{"id":9981,"name":"華道部","category":"文化部","source_url":"https://kaho-j.fku.ed.jp/wp-content/uploads/kaho_j/2026/07/09080822/文化部-R8★活動実績-4-6月.pdf","verified_at":"2026-08-07"},{"id":9982,"name":"美術部","category":"文化部","source_url":"https://kaho-j.fku.ed.jp/wp-content/uploads/kaho_j/2026/07/09080822/文化部-R8★活動実績-4-6月.pdf","verified_at":"2026-08-07"}],"profile_sources":[{"id":3334,"attribute_key":"feature_summary","source_url":"https://kaho-j.fku.ed.jp/gakkousyoukai/houshin/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3335,"attribute_key":"feature_description","source_url":"https://kaho-j.fku.ed.jp/gakkousyoukai/houshin/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
