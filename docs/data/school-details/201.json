{"id":201,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"課題学習で主体性を育てる附属中","feature_description":"富山大学教育学部附属中学校は、富山大学の附属校として、主体性の高まりをめざす課題学習を教育研究の中心に据えています。教育理念では、知性、情操、誠実さ、自主性、協働、実行力を重視しており、知識の習得だけでなく、課題を自分で見つけて考え抜く学び方を育てる姿勢が明確です。附中ネットの約束17条や部活動方針も公開されています。","clubs":[{"id":6313,"name":"サッカー部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6314,"name":"バレーボール部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6315,"name":"剣道部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6316,"name":"女子ソフトテニス部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6317,"name":"女子バドミントン部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6318,"name":"卓球部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6319,"name":"男子ソフトテニス部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6320,"name":"男子バスケットボール部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6321,"name":"男子バドミントン部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6322,"name":"野球部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6323,"name":"陸上部","category":"運動部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6324,"name":"コーラス部","category":"文化部","source_url":"https://fuzoku-jhs.edu.u-toyama.ac.jp/?tid=107110","verified_at":"2026-08-06"},{"id":6325,"name":"科学部","category":"文化部","source_ur