{"id":680,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"PLの教義を基盤に人間性を育てる教育","feature_description":"PLの教義を基盤に、学習と学校生活を通して人間性の向上を目指す中高一貫校です。一人ひとりの学びを支える学習サポートを行い、行事や芸術活動、部活動にも教員と指導者を配置しています。中学校と高等学校が連携する環境で、生徒が自らの役割を考え、仲間と協力しながら、心身ともに成長することを大切にしています。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12648,"name":"中学軟式野球部","category":"運動部","source_url":"https://www.pl-gakuen.ac.jp/school/seikatu/club/","verified_at":"2026-08-11"},{"id":12649,"name":"バトン部","category":"運動部","source_url":"https://www.pl-gakuen.ac.jp/school/seikatu/club/","verified_at":"2026-08-11"},{"id":12650,"name":"剣道部","category":"運動部","source_url":"https://www.pl-gakuen.ac.jp/school/seikatu/club/","verified_at":"2026-08-11"},{"id":12651,"name":"吹奏楽部","category":"文化部","source_url":"https://www.pl-gakuen.ac.jp/school/seikatu/club/","verified_at":"2026-08-11"},{"id":12652,"name":"美術部","category":"文化部","source_url":"https://www.pl-gakuen.ac.jp/school/seikatu/club/","verified_at":"2026-08-11"}],"profile_sources":[{"id":3682,"attribute_key":"feature_summary","source_url":"https://www.pl-gakuen.ac.jp/school/wp-content/uploads/junior_jigyohokoku.pdf","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3683,"attribute_key":"feature_description","source_url":"https://www.pl-gakuen.ac.jp/school/wp-content/uploads/junior_jigyohokoku.pdf","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
