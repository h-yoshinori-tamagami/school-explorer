{"id":685,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"中高一貫で探究と教養を重視する学び","feature_description":"千葉県立東葛飾中学校は県立東葛飾高等学校に併設され、六年間の中高一貫教育を行います。学校の教育方針では、授業と探究活動に加え、幅広い分野の教養にふれるリベラルアーツ講座などを活用しています。学校生活では中学のクラブ活動と、中学・高校が連携する部活動を進めています。学習と活動の両方を通して、生徒が興味を深め、他者と関わりながら学ぶ機会を設けています。","clubs":[],"profile_sources":[{"id":3815,"attribute_key":"feature_summary","source_url":"https://cms1.chiba-c.ed.jp/tohkatsu-jh/1502fae0f18f8eccdb9eff3e5db7f60c/%E6%95%99%E8%82%B2%E6%96%B9%E9%87%9D","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3816,"attribute_key":"feature_description","source_url":"https://cms1.chiba-c.ed.jp/tohkatsu-jh/1502fae0f18f8eccdb9eff3e5db7f60c/%E6%95%99%E8%82%B2%E6%96%B9%E9%87%9D","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3821,"attribute_key":"lunch_type","source_url":"https://cms1.chiba-c.ed.jp/tohkatsu-jh/faqs/faq_questions/index/155/limit%3A100?frame_id=327","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
