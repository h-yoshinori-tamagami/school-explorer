{"id":91,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数で学力と自立心を伸ばす女子教育","feature_description":"北豊島中学校・高等学校は、少人数の関わりを生かして、学力と人間性を丁寧に伸ばす女子校です。日々の授業、学校行事、進路指導、部活動を通して、自分で考え行動する力を育てます。生徒一人ひとりの目標や個性に寄り添い、社会で自立して活躍するための基礎を築きます。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":1018,"name":"バスケットボール部","category":"運動部","source_url":"https://www.kitatoshima.ed.jp/publics/index/246/","verified_at":"2026-08-06"},{"id":1019,"name":"バレーボール部","category":"運動部","source_url":"https://www.kitatoshima.ed.jp/publics/index/246/","verified_at":"2026-08-06"},{"id":1020,"name":"バドミントン部","category":"運動部","source_url":"https://www.kitatoshima.ed.jp/publics/index/246/","verified_at":"2026-08-06"},{"id":1021,"name":"バトン部","category":"運動部","source_url":"https://www.kitatoshima.ed.jp/publics/index/231/","verified_at":"2026-08-06"},{"id":1022,"name":"吹奏楽部","category":"文化部","source_url":"https://www.kitatoshima.ed.jp/publics/index/231/","verified_at":"2026-08-06"}],"profile_sources":[{"id":468,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=152","source_kind":"nichinoken","external_school_code":"152","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":469,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=152","source_kind":"nichinoken","external_school_code":"152","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":470,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=152","source_kind":"nichinoken","external_school_code":"152","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":471,"attribute_key":"high_school_progression","source_u