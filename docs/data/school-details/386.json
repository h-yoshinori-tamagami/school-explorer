{"id":386,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"独立自営と探究を育てる森村学園","feature_description":"森村学園 中等部・高等部は、建学の精神「独立自営」を土台に、6年間でイノベーションマインドを育てる学校です。課題解決型学習や外国語教育などの特色があり、部活動も約9割の生徒が参加します。学びと活動がつながり、自分の個性に合う場を選びやすい点が特徴です。日々の時間割や学校生活の中でも、その考え方が自然に生きています。探究と実践を往復しやすい点も魅力です。","clubs":[{"id":7214,"name":"陸上競技部","category":"運動部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7215,"name":"空手道部","category":"運動部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7216,"name":"ゴルフ部","category":"運動部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7217,"name":"管弦楽部","category":"文化部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7218,"name":"美術部","category":"文化部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7219,"name":"サッカー部","category":"運動部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"},{"id":7220,"name":"科学部","category":"文化部","source_url":"https://www.morimura.ac.jp/jsh/schoollife/club/","verified_at":"2026-08-07"}],"profile_sources":[{"id":3104,"attribute_key":"feature_summary","source_url":"https://www.morimura.ac.jp/jsh/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3105,"attribute_key":"feature_description","source_url":"https://www.morimura.ac.jp/jsh/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
