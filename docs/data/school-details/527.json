{"id":527,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自主自律の附属教育を行う筑波大附","feature_description":"筑波大学附属中学校は、筑波大学との連携のもと、中等普通教育と教育研究への協力を使命に掲げる附属校です。『強く、正しく、朗らかに』を教育方針とし、確かな知性と個性、民主的社会の一員として主体的に生きる力を育てます。学校生活では部活動や委員会活動も大切にしています。研究実習への協力も附属校ならではの役割で、学びの土台を人間形成とあわせて整えています。","clubs":[{"id":10383,"name":"野球部","category":"運動部","source_url":"https://www.high-s.tsukuba.ac.jp/jhs/life/club.html","verified_at":"2026-08-07"},{"id":10384,"name":"陸上競技部","category":"運動部","source_url":"https://www.high-s.tsukuba.ac.jp/jhs/life/club.html","verified_at":"2026-08-07"},{"id":10385,"name":"卓球部","category":"運動部","source_url":"https://www.high-s.tsukuba.ac.jp/jhs/life/club.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":1790,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=909","source_kind":"nichinoken","external_school_code":"909","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1791,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=909","source_kind":"nichinoken","external_school_code":"909","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1792,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=909","source_kind":"nichinoken","external_school_code":"909","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1793,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=909","source_kind":"nichinoken","external_school_code":"909","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"