{"id":249,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"附属東雲で研究と自治を育てる中学校","feature_description":"広島大学附属東雲中学校は、附属小学校と連携しながら、研究活動や学校生活を通して生徒の自治と学びを育てる学校です。学校説明会や研究会の案内が充実しており、国立附属校としての研究的な性格と地域への開かれた姿勢が見えます。 学校生活や部活動、行事の導線も整理され、比較用に学校全体の流れを追いやすいです。学びと日常のつながりも確認しやすいです。","clubs":[],"profile_sources":[{"id":2930,"attribute_key":"feature_summary","source_url":"https://www.hiroshima-u.ac.jp/fu_shino","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2931,"attribute_key":"feature_description","source_url":"https://www.hiroshima-u.ac.jp/fu_shino","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
