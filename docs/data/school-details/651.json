{"id":651,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"敬愛信と知徳体意で育む自律教育","feature_description":"「知・徳・体・意」の調和を基盤に、「敬・愛・信」を生活信条として学びと人間関係を育む中学校です。到達度に応じたきめ細かな学習指導に加え、進路実現に必要な学力、豊かな心と健やかな体を育てます。創造・解決・協調・自律の力を養い、礼儀を大切にしながら、一人ひとりが自らの目標に向かって成長できる教育を行います。豊かな人間関係を築く姿勢も大切にします。","clubs":[{"id":12123,"name":"剣道部","category":"運動部","source_url":"https://i-nisshinkan.com/pdf/juniorhigh_bosyuR6.pdf","verified_at":"2026-08-10"},{"id":12124,"name":"サッカー部","category":"運動部","source_url":"https://i-nisshinkan.com/pdf/juniorhigh_bosyuR6.pdf","verified_at":"2026-08-10"},{"id":12125,"name":"バスケットボール部","category":"運動部","source_url":"https://i-nisshinkan.com/pdf/juniorhigh_bosyuR6.pdf","verified_at":"2026-08-10"},{"id":12126,"name":"茶道部","category":"文化部","source_url":"https://i-nisshinkan.com/pdf/juniorhigh_bosyuR6.pdf","verified_at":"2026-08-10"}],"profile_sources":[{"id":2226,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=841","source_kind":"nichinoken","external_school_code":"841","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2227,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=841","source_kind":"nichinoken","external_school_code":"841","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3624,"attribute_key":"feature_summary","source_url":"https://i-nisshinkan.com/juniorhigh/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3625,"attribute_key":"feature_description","source_url":"https://i-nisshinkan.com/juniorhigh/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fet