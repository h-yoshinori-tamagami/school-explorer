{"id":315,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際性と主体性を育てる明星Institution","feature_description":"明星Institution中等教育部は、明星学苑の伝統に先進性を融合させた新しい中等教育部として、国際性、指導力、先見性、知的好奇心、主体性を育てる方針を打ち出しています。体験授業や説明会の案内からも、特色ある学びを段階的に体験できる構成が見えます。新設校として教育の方向が明快です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[],"profile_sources":[{"id":2978,"attribute_key":"feature_summary","source_url":"https://institution.meisei.ac.jp/admission/event/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2979,"attribute_key":"feature_description","source_url":"https://institution.meisei.ac.jp/admission/event/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
