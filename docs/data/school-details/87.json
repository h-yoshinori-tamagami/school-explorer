{"id":87,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際性と探究で自立した学習者を育む","feature_description":"加藤学園暁秀中学校・高等学校は、国際的な視野と主体的に学ぶ姿勢を育てる学校です。中高一貫の学び、英語教育、探究、行事を通して、自分の考えを表現し、仲間と協働する力を伸ばします。進路実現に向けた学力を高めながら、多様な社会で自立して行動する力を養います。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":844,"name":"サッカー部（男）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":845,"name":"バスケットボール部（男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":846,"name":"卓球部（男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":847,"name":"テニス部（硬式　男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":848,"name":"剣道部（男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":849,"name":"陸上部（男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":850,"name":"バドミントン部（男・女）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":851,"name":"総合部（フェンシング）","category":"運動部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":852,"name":"合唱部","category":"文化部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":853,"name":"吹奏楽部","category":"文化部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":854,"name":"放送部","category":"文化部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.php","verified_at":"2026-08-06"},{"id":855,"name":"広報部","category":"文化部","source_url":"https://www.katoh-net.ac.jp/GyoshuHS/JH/school_life.ph