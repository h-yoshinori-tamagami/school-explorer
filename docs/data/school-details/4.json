{"id":4,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"高い知性と豊かな感性を育む六年間の一貫教育","feature_description":"さいたま市立浦和中学校は、市立浦和高等学校との6年間の一貫教育を通じ、基礎学力に裏付けられた応用力や豊かな教養を育てます。教育目標に高い知性と豊かな感性・表現力を備えた国際社会に貢献できる生徒の育成を掲げ、日本の伝統文化に親しむ学習と国際教育を重視。学校行事や体験活動も通じて、一人ひとりの創造性・主体性・社会性を伸ばします。","clubs":[{"id":15299,"name":"吹奏楽部","category":"文化部","source_url":"https://www.m-urawa.ed.jp/index.cfm/1%2C19394%2C162%2C223%2Chtml","verified_at":"2026-11-20"}],"profile_sources":[{"id":17,"attribute_key":"uniform_policy","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":18,"attribute_key":"affiliation_name","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":19,"attribute_key":"affiliation_type","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":20,"attribute_key":"high_school_progression","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2358,"attribute_key":"feature_summary","source_url":"https://www.m-urawa.ed.jp/index.cfm/7%2C4321%2Cc%2Chtml/4321/20250702-124413.pdf","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2359,"attribute_key":"feature_description","source_url":"https://www.m-urawa.ed.jp/index.cfm/7%2C4321%2Cc