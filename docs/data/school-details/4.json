{"id":4,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"文武両道を受け継ぐ市立中高一貫教育","feature_description":"さいたま市立浦和中学校は、市立浦和高等学校と緊密に連携する併設型の中高一貫校です。高校が培ってきた文武両道の伝統を踏まえ、学問と部活動を両輪にした教育を行っています。高い知性に加え、豊かな感性と表現力を備え、国際社会に貢献できる生徒の育成を教育目標に掲げています。中高の教職員が一体となり、生徒の成長を支える体制を整えています。","clubs":[],"profile_sources":[{"id":17,"attribute_key":"uniform_policy","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":18,"attribute_key":"affiliation_name","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":19,"attribute_key":"affiliation_type","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":20,"attribute_key":"high_school_progression","source_url":"https://www.m-urawa.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2358,"attribute_key":"feature_summary","source_url":"https://www.m-urawa.ed.jp/handlers/printcontent.cfm?ContentID=11172&EntryCode=9062&GroupID=1&ThisPageURL=https%3A%2F%2Fwww.m-urawa.ed.jp%2Findex.cfm%2F1%2C0%2C44%2Chtml","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2359,"attribute_key":"feature_description","source_url":"https://www.m-urawa.ed.jp/handlers/printcontent.cfm?ContentID=11172&EntryCode=9062&GroupID=1&ThisPageURL=https%3A