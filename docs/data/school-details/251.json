{"id":251,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教と探究で学ぶ広島女学院","feature_description":"キリスト教主義教育を土台に、グローバル教育や学ぶ力を育む教育、中高一貫女子教育を組み合わせて学びを深める学校です。教育の特色、学校生活、クラブ活動の導線が整理され、学びと日常の両面を比較しやすい構成になっています。教育方針と学校生活のつながりが見えやすい点も特徴です。学校紹介、学校生活、部活動の導線が整理され、比較しやすい構成です。","clubs":[{"id":6270,"name":"新聞部","category":"文化部","source_url":"https://www.hjs.ed.jp/club","verified_at":"2026-08-06"},{"id":6271,"name":"バレー部","category":"運動部","source_url":"https://www.hjs.ed.jp/club","verified_at":"2026-08-06"},{"id":6272,"name":"吹奏楽部","category":"文化部","source_url":"https://www.hjs.ed.jp/club","verified_at":"2026-08-06"},{"id":6273,"name":"美術部","category":"文化部","source_url":"https://www.hjs.ed.jp/club","verified_at":"2026-08-06"},{"id":6274,"name":"卓球部","category":"運動部","source_url":"https://www.hjs.ed.jp/club","verified_at":"2026-08-06"}],"profile_sources":[{"id":937,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=670","source_kind":"nichinoken","external_school_code":"670","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":938,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=670","source_kind":"nichinoken","external_school_code":"670","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":939,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=670","source_kind":"nichinoken","external_school_code":"670","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":940,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=670","source_kind":"nichinoken","external_school_code":"6