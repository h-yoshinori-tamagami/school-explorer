{"id":612,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"大学附属の環境で探究力を育む中学校教育","feature_description":"長崎大学教育学部附属中学校は、大学附属校としての教育研究の環境を生かし、確かな学力と主体的に学ぶ力を育てます。教科の基礎を大切にしながら、対話や探究を通じて課題を見つけ、考えを表現する学びを進めます。学校生活や行事で多様な仲間と協働する経験を重ね、自らの成長を振り返りながら、地域と社会の未来に関わる力を養います。未来につながる学びを進めます。","clubs":[],"profile_sources":[{"id":3546,"attribute_key":"feature_summary","source_url":"https://www.jhs.edu.nagasaki-u.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3547,"attribute_key":"feature_description","source_url":"https://www.jhs.edu.nagasaki-u.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
