{"id":676,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由闊達な校風で自主自立を育む男子校","feature_description":"自由闊達・自主自立の校風のもと、男子の六年一貫教育を行う学校です。基本的な生活習慣と体力を土台に、生徒が物事を自主的に考え判断する力を育てます。独自のカリキュラムで学習意欲を引き出し、思考力、創造力、感受性を伸ばします。中高を通じた学びと多彩なクラブ活動の経験を通して、知性と感性を備えた自立した人物を目指します。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12632,"name":"アメリカン・フットボール部","category":"運動部","source_url":"https://www.azabu-jh.ed.jp/schoollife/club/","verified_at":"2026-08-11"},{"id":12633,"name":"アーチェリー部","category":"運動部","source_url":"https://www.azabu-jh.ed.jp/schoollife/club/","verified_at":"2026-08-11"},{"id":12634,"name":"サッカー部","category":"運動部","source_url":"https://www.azabu-jh.ed.jp/schoollife/club/","verified_at":"2026-08-11"},{"id":12635,"name":"お料理研究部","category":"文化部","source_url":"https://www.azabu-jh.ed.jp/schoollife/club/","verified_at":"2026-08-11"},{"id":12636,"name":"パーソナル・コンピュータ同好会","category":"同好会・愛好会","source_url":"https://www.azabu-jh.ed.jp/schoollife/club/","verified_at":"2026-08-11"}],"profile_sources":[{"id":2321,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=117","source_kind":"nichinoken","external_school_code":"117","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2322,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=117","source_kind":"nichinoken","external_school_code":"117","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2323,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=117","source_kind":"nichinoken","external_school_code":"117","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2324,"attribute_key