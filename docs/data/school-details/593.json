{"id":593,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"実学教育と探究を結ぶ中高大連携の学び","feature_description":"近畿大学附属東広島は、実学教育と人格の陶冶を基盤に、中学・高校・大学のつながりを生かした学びを行います。志望や到達度に応じた学習を通じて基礎学力を固め、グローバルプログラムや教科横断の探究で視野を広げます。課題を調べ、考えを伝える活動を重ねることで、探究心とコミュニケーション力を育てます。自ら考え行動し、進路を切り拓く力を養う教育です。","clubs":[{"id":11291,"name":"女子バレーボール部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11292,"name":"テニス部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11293,"name":"バスケットボール部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11294,"name":"卓球部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11295,"name":"陸上競技部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11296,"name":"剣道部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11297,"name":"男子サッカー部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11298,"name":"男子ソフトボール部","category":"運動部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11299,"name":"吹奏楽部","category":"文化部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11300,"name":"茶華道部","category":"文化部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11301,"name":"自然科学部","category":"文化部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11302,"name":"家庭科部","category":"文化部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11303,"name":"美術部","category":"文化部","source_url":"https://hh.kindai.ac.jp/life/club.php","verified_at":"2026-08-10"},{"id":11304,"name":"学問探究会","category":"文化部","source_url":"