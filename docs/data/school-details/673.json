{"id":673,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"道徳教育と言語技術を軸に学ぶ中高一貫校","feature_description":"道徳教育を教育の基盤に置き、感謝・自立・思いやりの心を育てる中高一貫校です。言語技術教育を通じて、考えを整理し相手に伝える力を養います。英語教育、海外研修、自分の関心を深めるプロジェクト型の学びを組み合わせ、生徒が自らの目標を見つけ、社会とつながりながら学び続ける力を伸ばします。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12617,"name":"軟式野球部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-08-11"},{"id":12618,"name":"男子バスケットボール部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-08-11"},{"id":12619,"name":"女子硬式テニス部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-08-11"},{"id":12620,"name":"日本文化部［茶道・箏楽］","category":"文化部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-08-11"},{"id":12621,"name":"科学部","category":"文化部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-08-11"}],"profile_sources":[{"id":3668,"attribute_key":"feature_summary","source_url":"https://www.hs.reitaku.jp/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3669,"attribute_key":"feature_description","source_url":"https://www.hs.reitaku.jp/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
