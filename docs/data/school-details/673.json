{"id":673,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"言語技術と英語教育を軸に探究へ進む","feature_description":"麗澤中学校は「世界が教室」を掲げ、言語技術教育、英語教育、自分プロジェクトを展開します。言語技術教育では筋道立てて考え、読解・記述・発表を行う力を磨き、英語教育では実践的な英語運用を目指します。自分プロジェクトは夢や希望を起点に、地球規模の課題を見つけ、調査や対話を通じて解決策を探究します。周囲と協力して課題を解決する姿勢も育てます。","clubs":[{"id":12617,"name":"軟式野球部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":12618,"name":"男子バスケットボール部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":12619,"name":"女子硬式テニス部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":12620,"name":"日本文化部［茶道・箏楽］","category":"文化部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":12621,"name":"科学部","category":"文化部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13992,"name":"女子バスケットボール部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13993,"name":"女子バレーボール研究会","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13994,"name":"男子硬式テニス部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13995,"name":"男子サッカー部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13996,"name":"ゴルフ部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13997,"name":"空手道部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13998,"name":"剣道部","category":"運動部","source_url":"https://www.hs.reitaku.jp/campuslife/club.html","verified_at":"2026-11-16"},{"id":13999,"name":"ラグビー部","category":"運動部","source_ur