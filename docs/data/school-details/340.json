{"id":340,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"未来にひらく自己を育てる東大附属","feature_description":"東京大学教育学部附属中等教育学校は、『未来にひらく自己の確立』を教育目標に掲げ、ことば、論理、身体・表現、関係、情報の五つの力を育てる学校です。2-2-2制の教育や総合学習、卒業研究など、本校独自の学びの仕組みが明快です。部活動も公式に整っています。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":6265,"name":"管弦楽部","category":"文化部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-08-06"},{"id":6266,"name":"生物部","category":"文化部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-08-06"},{"id":6267,"name":"卓球部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-08-06"},{"id":6268,"name":"陸上部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-08-06"},{"id":6269,"name":"テニス部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-08-06"}],"profile_sources":[{"id":2994,"attribute_key":"feature_summary","source_url":"https://www.hs.p.u-tokyo.ac.jp/aboutus/outline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2995,"attribute_key":"feature_description","source_url":"https://www.hs.p.u-tokyo.ac.jp/aboutus/outline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
