{"id":340,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"協働学習と卒業研究を柱にする東大附属","feature_description":"東京大学教育学部附属中等教育学校は6年一貫の中等教育学校で、教育目標に「未来にひらく自己の確立」を掲げます。教科と総合学習を結ぶ課題別学習や、東京大学と連携するフィールドワークに取り組み、学びを卒業研究にまとめます。前期課程では宿泊行事に関連したフィールドワークや発表を学び、後期課程では大学と連携した活動や国際理解のプログラムを行っています。","clubs":[{"id":6265,"name":"管弦楽部","category":"文化部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-11-19"},{"id":6266,"name":"生物部","category":"文化部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-11-19"},{"id":6267,"name":"卓球部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-11-19"},{"id":6268,"name":"陸上部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-11-19"},{"id":6269,"name":"テニス部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/schoollife/life","verified_at":"2026-11-19"},{"id":15026,"name":"演劇部","category":"文化部","source_url":"https://www.hs.p.u-tokyo.ac.jp/archives/80877","verified_at":"2026-11-19"},{"id":15027,"name":"水泳部","category":"運動部","source_url":"https://www.hs.p.u-tokyo.ac.jp/archives/96011","verified_at":"2026-11-19"}],"profile_sources":[{"id":2994,"attribute_key":"feature_summary","source_url":"https://www.hs.p.u-tokyo.ac.jp/aboutus/outline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2995,"attribute_key":"feature_description","source_url":"https://www.hs.p.u-tokyo.ac.jp/aboutus/outline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
