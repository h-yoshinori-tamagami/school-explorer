{"id":550,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教と六年一貫で伸ばす可能性","feature_description":"聖隷クリストファー中・高等学校は、キリスト教の精神を基盤に、他者の幸せを自らの喜びとする人を育てる学校です。中高六年一貫教育により、高校受験で学びを止めず、一人ひとりの個性や可能性に合わせて継続的に学力を伸ばします。学校周辺に集まる聖隷グループの医療・福祉・教育施設との連携を、授業、キャリア教育、部活動などに生かしています。高等学校には英数科と普通科があり、進路実現と学習・部活動の両立を支援しています。","clubs":[{"id":10521,"name":"男子サッカー部（聖隷ジュニアユースSC）","category":"運動部","source_url":"https://seirei.ed.jp/junior/life/club/","verified_at":"2026-08-08"},{"id":10522,"name":"女子サッカー部","category":"運動部","source_url":"https://seirei.ed.jp/junior/life/club/","verified_at":"2026-08-08"},{"id":10523,"name":"少林寺拳法部","category":"運動部","source_url":"https://seirei.ed.jp/junior/life/club/","verified_at":"2026-08-08"},{"id":10524,"name":"吹奏楽部","category":"文化部","source_url":"https://seirei.ed.jp/junior/life/club/","verified_at":"2026-08-08"},{"id":10525,"name":"和太鼓部","category":"文化部","source_url":"https://seirei.ed.jp/junior/life/club/","verified_at":"2026-08-08"}],"profile_sources":[{"id":3422,"attribute_key":"feature_summary","source_url":"https://seirei.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3423,"attribute_key":"feature_description","source_url":"https://seirei.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
