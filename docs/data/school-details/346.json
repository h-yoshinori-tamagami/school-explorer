{"id":346,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"愛情勤勉聡明で学ぶ家政附属女子","feature_description":"東京家政大学附属女子中学校・高等学校は、『愛情・勤勉・聡明』を生活信条に、探究と協働を重視する学校です。中学から高校へ段階的なカリキュラムで学び、英語や探究的な授業を通して、主体的に考え行動する力を育てます。高大連携も公式に案内されています。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5757,"name":"華道部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5758,"name":"手芸部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5759,"name":"イラスト部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5760,"name":"英語部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5761,"name":"合唱部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5762,"name":"理科部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5763,"name":"ブラスバンド部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"},{"id":5764,"name":"調理部","category":"文化部","source_url":"https://www.tokyo-kasei.ed.jp/schoollife/club","verified_at":"2026-08-06"}],"profile_sources":[{"id":2998,"attribute_key":"feature_summary","source_url":"https://www.tokyo-kasei.ed.jp/junior/subjects","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2999,"attribute_key":"feature_description","source_url":"https://www.tokyo-kasei.ed.jp/junior/subjects","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
