{"id":42,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"学力と人間力を伸ばし自立を目指す京華教育","feature_description":"京華のスクールミッションは「天下の英才を得て之を教育す」を建学の精神とし、学力・精神力・人間力の調和が取れた自立した男子の育成を目指します。基礎学力から思考力・表現力を段階的に伸ばし、自主性や主体性、探究心を育てます。多様な価値観を尊重し、他者と協働する姿勢や倫理観、困難に粘り強く向き合う力も重視します。礼儀や規律を基にした人間形成にも力を入れ、他者と協力しながら社会で活躍する力を育てます。","clubs":[{"id":14774,"name":"野球部(中学)","category":"運動部","source_url":"https://www.keika.ed.jp/club/","verified_at":"2026-11-16"},{"id":14775,"name":"サッカー部(中学)","category":"運動部","source_url":"https://www.keika.ed.jp/club/","verified_at":"2026-11-16"},{"id":14776,"name":"バスケットボール部(中学)","category":"運動部","source_url":"https://www.keika.ed.jp/club/","verified_at":"2026-11-16"},{"id":14777,"name":"テニス部(中学)","category":"運動部","source_url":"https://www.keika.ed.jp/club/","verified_at":"2026-11-16"}],"profile_sources":[{"id":2416,"attribute_key":"feature_summary","source_url":"https://www.keika.ed.jp/education/school_policy/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2417,"attribute_key":"feature_description","source_url":"https://www.keika.ed.jp/education/school_policy/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3790,"attribute_key":"lunch_type","source_url":"https://www.keika.ed.jp/faq/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
