{"id":611,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"カトリック精神と人間教育を軸に学ぶ男子教育","feature_description":"長崎南山は、キリスト教の精神を土台に、一人ひとりを大切にする人間教育を行う中高一貫校です。日々の学習に加え、学校行事や部活動で仲間と関わる経験を重ね、他者への敬意と自ら考えて行動する姿勢を育てます。六年間の見通しを持った学びと生活指導を通じて、基礎学力と豊かな人間性をバランスよく伸ばし、社会に役立つ人を育成します。未来につながる学びを進めます。","clubs":[],"profile_sources":[{"id":2086,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=862","source_kind":"nichinoken","external_school_code":"862","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2087,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=862","source_kind":"nichinoken","external_school_code":"862","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2088,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=862","source_kind":"nichinoken","external_school_code":"862","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2089,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=862","source_kind":"nichinoken","external_school_code":"862","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2090,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=862","source_kind":"nichinoken","external_school_code":"862","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3544,"attribute_key":"feature_summary","source_url":"https://www.n-nanzan.ed