{"id":32,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"誠実と探究で未来を拓く附属教育","feature_description":"中央大学附属横浜中学校・高等学校は、中央大学の附属校として、学力の育成と人間形成を両立する教育を行っています。誠実に学ぶ姿勢を大切にし、探究活動、英語教育、ICT活用、行事や部活動を通して主体性と協働性を伸ばします。大学との接続も意識しながら、自分の将来を考え続ける力を育てる学校です。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":252,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=331","source_kind":"nichinoken","external_school_code":"331","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":253,"attribute_key":"dormitory_available","source_url":"https://www.yokohama-js.chuo-u.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":254,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=331","source_kind":"nichinoken","external_school_code":"331","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":255,"attribute_key":"affiliation_name","source_url":"https://www.yokohama-js.chuo-u.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":256,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=331","source_kind":"nichinoken","external_school_code":"331","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":257,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=331","source_kind":"nichinoken","external_scho