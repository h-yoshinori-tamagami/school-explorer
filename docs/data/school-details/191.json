{"id":191,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究と実践を育む宮崎大附属中学校","feature_description":"宮崎大学教育学部附属中学校は、教育実践研究の中核校として探究的な学びと生徒の自主性を重視しています。学校生活では部活動が案内され、公式ページでは運動部を中心に中高生らしい活動の様子が確認できました。学びの深化と学校生活の両立を支える構成です。 宮崎大学との連携を背景に、研究と実践の往復を通じて、生徒自身が考え抜く力を鍛える学校像が伝わります。","clubs":[{"id":3454,"name":"サッカー部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3455,"name":"野球部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3456,"name":"女子ソフトテニス部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3457,"name":"男子ソフトテニス部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3458,"name":"女子バスケットボール部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3459,"name":"男子バスケットボール部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3460,"name":"女子バレーボール部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"},{"id":3461,"name":"男子バレーボール部","category":"運動部","source_url":"https://www.miyazaki-u.ac.jp/jhs/schoollife/club.html","verified_at":"2026-08-06"}],"profile_sources":[{"id":2698,"attribute_key":"feature_summary","source_url":"https://www.miyazaki-u.ac.jp/jhs/about/history.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2699,"attribute_key":"feature_description","source_url":"https://www.miyazaki-u.ac.jp/jhs/about/history.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"