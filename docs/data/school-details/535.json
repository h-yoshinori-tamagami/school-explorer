{"id":535,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"六年一貫と国際教育で個性を伸ばす学校","feature_description":"美濃加茂中学校は、中高一貫教育により六年後を見据え、計画的・継続的に一人ひとりの個性を伸ばす学校です。放課後には一般教養講座と部活動を用意し、学びと興味関心の両方を深める機会を設けています。オーストラリア研修などの国際教育も学校行事の柱で、異文化に触れる経験を積みます。剣道・柔道・ブラスバンドを毎日、陸上・硬式テニス・同好会を週二回行う構成も特色です。","clubs":[],"profile_sources":[{"id":1822,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=586","source_kind":"nichinoken","external_school_code":"586","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1823,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=586","source_kind":"nichinoken","external_school_code":"586","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1824,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=586","source_kind":"nichinoken","external_school_code":"586","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1825,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=586","source_kind":"nichinoken","external_school_code":"586","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1826,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=586","source_kind":"nichinoken","external_school_code":"586","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1827,"attribute_key":"learning_support","source_url":"https://www.nichinoken.c