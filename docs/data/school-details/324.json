{"id":324,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"グローバルと探究で骨太な資質を育む秀英","feature_description":"昭和学院秀英中学校・高等学校は、『骨太な進学校』として、グローバル教育、サイエンス教育、探究の三本柱で学びを進める学校です。英語教育や語学研修に加え、文理融合の視点で思考力と問題解決力を育て、自ら学び行動する力を伸ばします。自己実現を支える方針が明確です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5610,"name":"テニス部","category":"運動部","source_url":"https://www.showa-shuei.ed.jp/campus_life/club/","verified_at":"2026-08-06"},{"id":5611,"name":"化学・物理部","category":"文化部","source_url":"https://www.showa-shuei.ed.jp/campus_life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":1144,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=403","source_kind":"nichinoken","external_school_code":"403","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1145,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=403","source_kind":"nichinoken","external_school_code":"403","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1146,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=403","source_kind":"nichinoken","external_school_code":"403","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1147,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=403","source_kind":"nichinoken","external_school_code":"403","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2960,"attribute_key":"feature_summary","source_url":"https://www.showa-shuei.ed.jp/introduction/schoolpolicy/","source_ki