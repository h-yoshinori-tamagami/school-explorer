{"id":625,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"奉仕の精神と対面重視の人間教育","feature_description":"奉仕の精神と対面重視の人間教育を教育の中心に据え、教科の学びと学校生活を結び付けながら、生徒が自ら考え行動する力を育てます。基礎となる知識や技能を着実に身に付けるとともに、探究、対話、行事、部活動などの経験を通して、多様な仲間と協働し課題に向き合います。一人ひとりが自分の目標を見つけ、学びを深め、社会や世界に関わる視野を広げられるよう支える教育です。","clubs":[],"profile_sources":[{"id":3572,"attribute_key":"feature_summary","source_url":"https://kantogakuin.ed.jp/introduction/idea.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3573,"attribute_key":"feature_description","source_url":"https://kantogakuin.ed.jp/introduction/idea.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
