{"id":90,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"地域と自然の中で主体的に学ぶ中高一貫","feature_description":"北杜市立甲陵中学校・高等学校は、地域と自然に恵まれた環境の中で、6年間を見通した学びを行う公立中高一貫校です。基礎学力、探究、学校行事を通して、自ら課題を見つけ、仲間と協働する力を育てます。地域社会に目を向けながら、将来の進路を主体的に考える姿勢を養います。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":974,"name":"男女バスケットボール部","category":"運動部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":975,"name":"テニス部","category":"運動部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":976,"name":"卓球部","category":"運動部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":977,"name":"弓道部","category":"運動部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":978,"name":"陸上部","category":"運動部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":979,"name":"美術部","category":"文化部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"},{"id":980,"name":"箏曲部","category":"文化部","source_url":"https://hokutoed.main.jp/koryojhs/部活動/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2512,"attribute_key":"feature_summary","source_url":"https://hokutoed.main.jp/koryojhs/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2513,"attribute_key":"feature_description","source_url":"https://hokutoed.main.jp/koryojhs/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
