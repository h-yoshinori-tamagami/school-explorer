{"id":222,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"未来航路で志を育てる岡山操山中","feature_description":"岡山県立岡山操山中学校は、岡山操山高等学校と共に中高一貫教育を行い、『和して流れず・松柏の精神』のもとで高い志、確かな学力、豊かな人間性を育てています。未来航路プロジェクトでは、自ら問いを立てて探究を深め、グローバル社会で活躍する力を養う方針が示されています。生徒の主体性を支える設計が明確で、教科横断の探究活動も重視されています。","clubs":[{"id":4834,"name":"サッカー部","category":"運動部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4835,"name":"ソフトテニス部","category":"運動部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4836,"name":"バスケ部","category":"運動部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4837,"name":"バレー部","category":"運動部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4838,"name":"演劇部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4839,"name":"吹奏楽部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4840,"name":"美術部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4841,"name":"書道部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4842,"name":"華道部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"},{"id":4843,"name":"囲碁・将棋部","category":"文化部","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2876,"attribute_key":"feature_summary","source_url":"https://www.sozan-jhs.okayama-c.ed.jp/overview/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2877,"attribute_key":"feature_description",