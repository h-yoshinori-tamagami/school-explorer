{"id":672,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教の精神を基盤にした女子教育","feature_description":"キリスト教の精神を土台に、知性と豊かな人間性を育む女子の中高一貫校です。礼法や奉仕活動、大学による特別講座などの体験学習を取り入れ、自分と社会を見つめる学びを進めます。英語4技能の育成や海外研修を含む異文化体験にも力を入れ、探究と実践を通して、多様な人々と協働できる力を養います。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12612,"name":"バスケットボール部","category":"運動部","source_url":"https://www.k-junshin.ed.jp/club/","verified_at":"2026-08-11"},{"id":12613,"name":"テニス部","category":"運動部","source_url":"https://www.k-junshin.ed.jp/club/","verified_at":"2026-08-11"},{"id":12614,"name":"新体操部","category":"運動部","source_url":"https://www.k-junshin.ed.jp/club/","verified_at":"2026-08-11"},{"id":12615,"name":"放送部","category":"文化部","source_url":"https://www.k-junshin.ed.jp/club/","verified_at":"2026-08-11"},{"id":12616,"name":"音楽部ハンドベル隊","category":"文化部","source_url":"https://www.k-junshin.ed.jp/club/","verified_at":"2026-08-11"}],"profile_sources":[{"id":2301,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=883","source_kind":"nichinoken","external_school_code":"883","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2302,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=883","source_kind":"nichinoken","external_school_code":"883","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2303,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=883","source_kind":"nichinoken","external_school_code":"883","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2304,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/ind