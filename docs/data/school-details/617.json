{"id":617,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"カトリックの精神で自立を育む女子教育","feature_description":"長崎精道は、カトリックの精神を基盤に、一人ひとりの尊厳を大切にする女子教育を行います。日々の学びと学校生活の中で、自分を深く見つめ、他者に仕える心と自立して行動する力を育てます。教科の学習だけでなく、対話、体験、行事を通して多様な価値観に触れ、仲間と協働して考えを形にする経験を重ね、社会に貢献する人を目指します。未来につながる学びを進めます。","clubs":[],"profile_sources":[{"id":2096,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=861","source_kind":"nichinoken","external_school_code":"861","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2097,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=861","source_kind":"nichinoken","external_school_code":"861","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2098,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=861","source_kind":"nichinoken","external_school_code":"861","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2099,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=861","source_kind":"nichinoken","external_school_code":"861","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3556,"attribute_key":"feature_summary","source_url":"https://www.nagasaki-seido.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3557,"attribute_key":"feature_description","source_url":"https://www.nagasaki-seido.ed.jp/","source_kind":"official_site","ex