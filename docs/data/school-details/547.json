{"id":547,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"STEAMとグローバルで挑む未来創造教育","feature_description":"聖徳学園は、STEAM教育とグローバル教育を両輪に、正解のない問題へ挑戦する力を育てる中高一貫校です。教科で学んだ知識や技術を活用して問題解決の道筋を設計する思考力を重視し、国境を越えて自分を表現する力も養います。高校二年からは適性や希望進路に応じてクラスを編成し、データサイエンスコースでは文理融合の探究と英語イマージョンを行います。主体的に問いを立て、データから解決策を導く学びを進めています。","clubs":[{"id":10506,"name":"高校男子バレーボール","category":"運動部","source_url":"https://jsh.shotoku.ed.jp/school-life/club_athletic/","verified_at":"2026-08-08"},{"id":10507,"name":"中高男子バスケットボール","category":"運動部","source_url":"https://jsh.shotoku.ed.jp/school-life/club_athletic/","verified_at":"2026-08-08"},{"id":10508,"name":"女子ラクロス","category":"運動部","source_url":"https://jsh.shotoku.ed.jp/school-life/club_athletic/","verified_at":"2026-08-08"},{"id":10509,"name":"鉄道研究","category":"文化部","source_url":"https://jsh.shotoku.ed.jp/school-life/club_cultural/","verified_at":"2026-08-08"},{"id":10510,"name":"動画研究","category":"文化部","source_url":"https://jsh.shotoku.ed.jp/school-life/club_cultural/","verified_at":"2026-08-08"}],"profile_sources":[{"id":3416,"attribute_key":"feature_summary","source_url":"https://jsh.shotoku.ed.jp/educational_content/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3417,"attribute_key":"feature_description","source_url":"https://jsh.shotoku.ed.jp/educational_content/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
