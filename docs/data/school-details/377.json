{"id":377,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"表現する力を6年間で育む桐光学園","feature_description":"桐光学園は中高6年間を通じ、「考えること＝書くこと・表現すること」をすべての学びの基本に置いています。学年ごとに人間関係づくりや自己理解、進路などのテーマを設け、教科・行事・活動で段階的に学びます。中学1年では授業の受け方や家庭学習の習慣を身につけ、基礎学力の定着を図ります。人間関係づくりや自己発見も学年テーマとして扱います。","clubs":[],"profile_sources":[{"id":3086,"attribute_key":"feature_summary","source_url":"https://www.toko.ed.jp/high/study/index.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3087,"attribute_key":"feature_description","source_url":"https://www.toko.ed.jp/high/study/index.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3756,"attribute_key":"lunch_type","source_url":"https://www.toko.ed.jp/high/campuslife/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
