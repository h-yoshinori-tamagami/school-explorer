{"id":374,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"全員参加の課外活動で育つ栄光学園","feature_description":"栄光学園は、全員参加の課外活動を大切な教育活動と位置づけ、週2日を原則に学びと活動を両立させる学校です。中高で役割を分け合いながら、創意工夫して活動する文化があり、宗教活動やボランティアも含めて成長の機会が豊富です。学習だけでなく、人としての幅を広げる時間を重視しています。互いを支える経験が自然に積み重なります。学びの幅も広がります。","clubs":[{"id":6858,"name":"生物研究部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6859,"name":"美術部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6860,"name":"物理研究部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6861,"name":"ブラスバンド部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6862,"name":"囲碁将棋部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6863,"name":"歴史研究部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6864,"name":"英語部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6865,"name":"クイズ研究部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"},{"id":6866,"name":"文芸部","category":"文化部","source_url":"https://www.eiko.ed.jp/life/kagai/index.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":1296,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=344","source_kind":"nichinoken","external_school_code":"344","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1297,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=344","source_kind":"nichinoken","external_school_code