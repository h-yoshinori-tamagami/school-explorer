{"id":674,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"寮生活と四つの柱で深める学びの特色","feature_description":"自然に囲まれた広いキャンパスと寮を備え、全国から集まる生徒が学ぶ中高一貫校です。確かな学力、探究・キャリア教育、英語・国際教育、道徳教育の四つを柱に教育を進めます。授業や行事だけでなく、寮生活での濃密な人間関係も学びの場とし、自分の目標に向けて才能や個性を伸ばしながら、自立して学ぶ姿勢を育てます。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12622,"name":"卓球部","category":"運動部","source_url":"https://www.mz.reitaku.jp/school/club","verified_at":"2026-08-11"},{"id":12623,"name":"テニス部（中高男子）","category":"運動部","source_url":"https://www.mz.reitaku.jp/school/club","verified_at":"2026-08-11"},{"id":12624,"name":"テニス部（中高女子）","category":"運動部","source_url":"https://www.mz.reitaku.jp/school/club","verified_at":"2026-08-11"},{"id":12625,"name":"吹奏楽部","category":"文化部","source_url":"https://www.mz.reitaku.jp/school/club","verified_at":"2026-08-11"},{"id":12626,"name":"太鼓部","category":"文化部","source_url":"https://www.mz.reitaku.jp/school/club","verified_at":"2026-08-11"}],"profile_sources":[{"id":2309,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=583","source_kind":"nichinoken","external_school_code":"583","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2310,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=583","source_kind":"nichinoken","external_school_code":"583","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2311,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=583","source_kind":"nichinoken","external_school_code":"583","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2312,"attribute_key":"lunch_type","source_url":"https://www.nichinoke