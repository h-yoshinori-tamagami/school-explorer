{"id":493,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究学習と英語教育で進む山手改革","feature_description":"神戸山手グローバル中学校高等学校は、英語教育・高大連携教育・自己調整学習・協働的な学び（探究学習）を柱に、2026年に新たなスタートを切った学校です。グローバル化する社会で本質を見極めて行動できる生徒を育てるため、個別最適な学びと対話を重ねる学校文化を整えています。クラブ活動や校内予備校も含め、学びの幅が広いです。教育ミッションの3Cも明示されています。","clubs":[{"id":9784,"name":"陸上競技部","category":"運動部","source_url":"https://www.kobeyamate.ed.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9785,"name":"卓球部","category":"運動部","source_url":"https://www.kobeyamate.ed.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9786,"name":"吹奏楽部","category":"文化部","source_url":"https://www.kobeyamate.ed.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9787,"name":"スポーツクライミング部","category":"運動部","source_url":"https://www.kobeyamate.ed.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9788,"name":"インラインスケート","category":"運動部","source_url":"https://www.kobeyamate.ed.jp/","verified_at":"2026-08-07"}],"profile_sources":[{"id":1691,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=760","source_kind":"nichinoken","external_school_code":"760","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1692,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=760","source_kind":"nichinoken","external_school_code":"760","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1693,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=760","source_kind":"nichinoken","external_school_code":"760","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1694,"attribute_key":"high_school_progression","source_u