{"id":406,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"インクルーシブ教育で志と心を育てる","feature_description":"吉祥寺学園中等部は、インクルーシブ教育を掲げ、ASD児教育や習熟度別授業で一人ひとりに合う学びを用意する学校です。特色ある教科カリキュラムに加え、生徒自身が学校生活や行事を主体的に運営する気風があり、安心感と挑戦の両方を得やすい点が特徴です。少人数の良さを生かし、意見を形にしやすい環境です。少人数ならではの対話が積み重なります。","clubs":[{"id":7712,"name":"バスケットボール部","category":"運動部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7713,"name":"野球部","category":"運動部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7714,"name":"テニス部","category":"運動部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7715,"name":"サッカー部","category":"運動部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7716,"name":"卓球部","category":"運動部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7717,"name":"吹奏楽部","category":"文化部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7718,"name":"美術部","category":"文化部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7719,"name":"ESS","category":"文化部","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7720,"name":"空手同好会","category":"同好会・愛好会","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"},{"id":7721,"name":"科学研究同好会","category":"同好会・愛好会","source_url":"https://www.k-g.ed.jp/chugaku/?page_id=87","verified_at":"2026-08-07"}],"profile_sources":[{"id":3142,"attribute_key":"feature_summary","source_url":"https://www.k-g.ed.jp/chugaku/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3143,"attribute_key":"feature_description","source_url":"https://www.k-g.ed.jp/chugaku/","source_kind":"off