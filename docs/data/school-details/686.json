{"id":686,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際・理数・ICTを含む中学校の学び","feature_description":"府中の明星中学校は、教科学習で身に付ける学力と、日々の活動で培う力をともに重視しています。中学校の教育プログラムには国際教育、理数教育、ICT教育、キャリア教育があり、複数の分野から学びを広げる機会を設けています。特別選抜クラスでは教科書の学習に加えて、自分で学ぶ力を伸ばすことを重視し、長い見通しを持って希望する大学への進学に向けた学習を進めます。","clubs":[],"profile_sources":[{"id":3817,"attribute_key":"feature_summary","source_url":"https://www.meisei.ac.jp/hs/j/education/index.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3818,"attribute_key":"feature_description","source_url":"https://www.meisei.ac.jp/hs/j/education/index.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
