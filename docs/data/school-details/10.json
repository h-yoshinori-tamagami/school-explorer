{"id":10,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"奉仕する心を持つリーダーを育成","feature_description":"サレジオ学院中学校・高等学校は、「25歳の男づくり」を掲げ、奉仕する心を持つリーダーの育成を目指しています。日々の学習に加え、学校行事や生徒活動の報告を通じて、生徒が多様な経験を重ねる学校生活を案内しています。自分の成長を社会や他者への貢献につなげようとする姿勢を大切にする男子校です。公式サイトの紹介内容をもとにまとめています。","clubs":[{"id":1,"name":"剣道部","category":"運動部","source_url":"https://www.salesio-gakuin.ed.jp/clubs/","verified_at":"2026-08-04"},{"id":2,"name":"サッカー部","category":"運動部","source_url":"https://www.salesio-gakuin.ed.jp/clubs/","verified_at":"2026-08-04"},{"id":3,"name":"軽音楽部","category":"文化部","source_url":"https://www.salesio-gakuin.ed.jp/clubs/","verified_at":"2026-08-04"},{"id":4,"name":"吹奏楽部","category":"文化部","source_url":"https://www.salesio-gakuin.ed.jp/clubs/","verified_at":"2026-08-04"},{"id":5,"name":"将棋囲碁同好会","category":"同好会・愛好会","source_url":"https://www.salesio-gakuin.ed.jp/clubs/","verified_at":"2026-08-04"}],"profile_sources":[{"id":48,"attribute_key":"religious_background","source_url":"https://www.salesio-gakuin.ed.jp/webbook/2026/pageindices/index2.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":49,"attribute_key":"uniform_policy","source_url":"https://www.salesio-gakuin.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":50,"attribute_key":"lunch_type","source_url":"https://www.salesio-gakuin.ed.jp/webbook/2026/pageindices/index22.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":51,"attribute_key":"high_school_progression","source_url":"https://www.salesio-gakuin.ed.jp/","source_kind":"official_site","external_school_code":null,