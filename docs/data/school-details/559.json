{"id":559,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"思考重視とICTで学び方を深める教育","feature_description":"英明フロンティア中学校は、何を学ぶかだけでなく、どのように学び、知識をどう生かすかを大切にします。基礎知識に加え、考える・調べる・まとめる・分析する・表現する力を基礎学力と捉える思考重視型授業を行います。ICT教育では、タブレットの活用にとどまらず、文書作成、表計算、プレゼンテーションの基礎を学び、学びや活動の記録にも活用します。ゼミ学習や放課後学習の環境も整え、主体的な進路形成を支えます。","clubs":[{"id":10599,"name":"バスケットボール部","category":"運動部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10600,"name":"硬式テニス部","category":"運動部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10601,"name":"バドミントン部","category":"運動部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10602,"name":"ダンス部","category":"運動部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10603,"name":"合唱・コーラス部","category":"文化部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10604,"name":"管弦楽部","category":"文化部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"},{"id":10605,"name":"美術・工芸部","category":"文化部","source_url":"https://eimei-frontier.ed.jp/school-life/club-activities/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1919,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=244","source_kind":"nichinoken","external_school_code":"244","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1920,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=244","source_kind":"nichinoken","external_school_code":"244","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"pri