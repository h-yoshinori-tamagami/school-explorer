{"id":224,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由な校風とICT・寮生活の岩田","feature_description":"岩田中学校・高等学校は、中高一貫の学びに加えてICT教育、学校生活、寮生活、生徒会活動を組み合わせた設計が特徴です。部活動は学業との両立を前提に、スポーツ系と文化系の両面で幅広い選択肢を示しており、自由な校風の中で主体性を育てています。 学校生活や部活動、行事の導線も整理され、比較用に学校全体の流れを追いやすいです。学びと日常のつながりも確認しやすいです。","clubs":[{"id":4856,"name":"サッカー部","category":"運動部","source_url":"https://iwata.ed.jp/schoollife/","verified_at":"2026-08-06"},{"id":4857,"name":"ヨガ・ピラティス部","category":"運動部","source_url":"https://iwata.ed.jp/schoollife/","verified_at":"2026-08-06"},{"id":4858,"name":"ギター部","category":"文化部","source_url":"https://iwata.ed.jp/schoollife/","verified_at":"2026-08-06"},{"id":4859,"name":"プロジェクト部","category":"文化部","source_url":"https://iwata.ed.jp/schoollife/","verified_at":"2026-08-06"},{"id":4860,"name":"IAC","category":"同好会・愛好会","source_url":"https://iwata.ed.jp/schoollife/","verified_at":"2026-08-06"}],"profile_sources":[{"id":850,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=875","source_kind":"nichinoken","external_school_code":"875","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":851,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=875","source_kind":"nichinoken","external_school_code":"875","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":852,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=875","source_kind":"nichinoken","external_school_code":"875","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":853,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code