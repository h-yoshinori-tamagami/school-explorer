{"id":248,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"研究的な学びと地域連携の附属三原","feature_description":"広島大学附属三原中学校は、広島大学の附属校として、教育目標や研究活動、地域貢献をつないだ学校運営を行っています。学校園生活の案内や研究活動のページが整っており、幼小中の連携を前提にした学びの流れが公式に確認できます。 学校生活や部活動、行事の導線も整理され、比較用に学校全体の流れを追いやすいです。学びと日常のつながりも確認しやすいです。","clubs":[],"profile_sources":[{"id":2928,"attribute_key":"feature_summary","source_url":"https://www.hiroshima-u.ac.jp/fu_mihara","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2929,"attribute_key":"feature_description","source_url":"https://www.hiroshima-u.ac.jp/fu_mihara","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
