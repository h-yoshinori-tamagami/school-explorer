{"id":44,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究とICTで未来を創る力を育む","feature_description":"京都先端科学大学附属中学校高等学校は、大学附属校としての学びを生かし、探究、ICT、英語教育を通じて主体的に考える力を育てます。知識を身に付けるだけでなく、課題を見つけ、仲間と協働しながら解決へ向かう姿勢を重視します。変化する社会で自分の可能性を広げ、未来を創る力を養う学校です。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":2420,"attribute_key":"feature_summary","source_url":"https://www.js.kuas.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2421,"attribute_key":"feature_description","source_url":"https://www.js.kuas.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
