{"id":332,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"IBの探究で思考力を育てる朝日塾","feature_description":"朝日塾中等教育学校は、国際バカロレアのMYP・DP認定校として、教科横断の学びと探究型学習を進める学校です。思考力、判断力、表現力を育てるスクールポリシーが明示され、ICT活用や多様な言語背景への配慮も見えます。学校生活と学習方針がつながっています。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":6208,"name":"バレーボール部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6209,"name":"軟式野球部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6210,"name":"テニス部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6211,"name":"水泳部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6212,"name":"室内運動部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6213,"name":"室内運動部 (卓球)","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6214,"name":"サッカー部","category":"運動部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6215,"name":"科学部","category":"文化部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6216,"name":"家庭科部","category":"文化部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6217,"name":"美術部","category":"文化部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6218,"name":"音楽部","category":"文化部","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6219,"name":"ACT (写真同好会)","category":"同好会・愛好会","source_url":"https://m-asahijuku.ed.jp/schoollife/club.html","verified_at":"2026-08-06"},{"id":6220,"name":"演劇部","category":"文化部","source_url":"https://m-asahijuku.ed.jp/scho