{"id":467,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究と国際教育を磨く女子一貫校","feature_description":"甲南女子中学校・高等学校は、「まことの人間をつくる」という教育理念のもと、探究・国際教育・ICT活用・学習サポートを教育の柱に掲げます。6年間を通じた英語学習と国際的な視野を育む取組に加え、生徒が自ら問いを立てて考える探究学習を進めています。一人ひとりの個性や学力を尊重し、適性や目標に応じて学びを支える方針です。多様な学びを大切にします。","clubs":[],"profile_sources":[{"id":1599,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=771","source_kind":"nichinoken","external_school_code":"771","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1600,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=771","source_kind":"nichinoken","external_school_code":"771","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1601,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=771","source_kind":"nichinoken","external_school_code":"771","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1602,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=771","source_kind":"nichinoken","external_school_code":"771","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1603,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=771","source_kind":"nichinoken","external_school_code":"771","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3694,"attribute_key":"feature_summary","source_url":"https://www.konan-gs.ed.jp/curriculum/","sourc