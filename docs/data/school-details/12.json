{"id":12,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"三つの教育で探究する女性を育む学園","feature_description":"トキワ松学園中学校高等学校は、問題を見つけ、調べ、仲間と分かち合える「探究女子」の育成を掲げています。論理的思考力と表現力を養う思考力教育、多様な価値観を尊重して協働する国際力教育、豊かな感性と創造力を育む美の教育を三つの柱としています。好奇心と自立心を伸ばし、正解のない問いを考え続ける力を大切にする女子校です。学校の特色です。","clubs":[],"profile_sources":[{"id":62,"attribute_key":"religious_background","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":63,"attribute_key":"dormitory_available","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":64,"attribute_key":"uniform_policy","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":65,"attribute_key":"affiliation_name","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":66,"attribute_key":"lunch_type","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":67,"attribute_key":"affiliation_type","source_url":"https://www.tokiwamatsu.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":68,"attribute_key":"hig