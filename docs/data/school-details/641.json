{"id":641,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際バカロレアと少人数で育む探究教育","feature_description":"国際バカロレアと少人数で育む探究教育を教育の核に据え、教科の学びと学校生活を結び付けながら、生徒が自ら考え行動する力を育てます。基礎となる知識や技能を着実に身に付けるとともに、探究、対話、行事、部活動などの経験を通して、多様な仲間と協働し課題に向き合います。一人ひとりが目標を見つけ、学びを深め、社会や世界に関わる視野を広げられるよう支える教育です。","clubs":[{"id":11963,"name":"女子バレーボール部（強化指定）","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11964,"name":"男子バスケットボール部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11965,"name":"女子バスケットボール部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11966,"name":"男子テニス部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11967,"name":"女子テニス部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11968,"name":"卓球部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11969,"name":"弓道部","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"},{"id":11970,"name":"陸上部（強化指定）","category":"運動部","source_url":"https://ssalesio.ac.jp/junior/life/method/activity/","verified_at":"2026-08-10"}],"profile_sources":[{"id":2188,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=552","source_kind":"nichinoken","external_school_code":"552","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2189,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=552","source_kind":"nichinoken","external_school_code":"552","verified_at":"2026-08-