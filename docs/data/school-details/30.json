{"id":30,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自律自修と志学で社会に貢献する力を育む","feature_description":"東京都立両国高等学校・附属中学校は、「自律自修」の精神に基づき、自ら考え自ら学ぶ態度と、社会に貢献する高い志を育てます。6年間一貫した教育の中で、基礎から発展へつなぐ授業、探究活動、体験的学習、英語によるコミュニケーションを展開します。職場体験や卒業研究などを「志学」と位置付け、未来を切り拓くリーダーを目指す学校です。","clubs":[],"profile_sources":[{"id":232,"attribute_key":"religious_background","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":233,"attribute_key":"dormitory_available","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":234,"attribute_key":"uniform_policy","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":235,"attribute_key":"affiliation_name","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":236,"attribute_key":"lunch_type","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":237,"attribute_key":"affiliation_type","source_url":"https://www.metro.ed.jp/ryogoku-h/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"