{"id":587,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数支援と探究を通じて進路を切り拓く学び","feature_description":"賢明学院は、少人数での学習支援と丁寧な面談を通じて、一人ひとりが進路を切り拓く力を育てます。五教科の確かな学びを基盤に、探究や特別活動、Ai GROWなどを取り入れ、自分の強みや課題を見つめます。学習と部活動・課外活動を両立させながら、考えを深め、他者と協働する経験を重ねます。日常的な対話と振り返りを通じ、自ら目標を定めて行動する姿勢を養う教育です。","clubs":[],"profile_sources":[{"id":2003,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=750","source_kind":"nichinoken","external_school_code":"750","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2004,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=750","source_kind":"nichinoken","external_school_code":"750","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2005,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=750","source_kind":"nichinoken","external_school_code":"750","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2006,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=750","source_kind":"nichinoken","external_school_code":"750","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2007,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=750","source_kind":"nichinoken","external_school_code":"750","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3496,"attribute_key":"feature_summary","source_url":"https://kenmei.jp