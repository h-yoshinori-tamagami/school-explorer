{"id":681,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数と平和教育で育む人間力の特色","feature_description":"キリスト教主義のもと、真の平和をつくり出す人を世に送り出すことを目指す中高一貫校です。中学は少人数クラスで、グループ学習やアクティブラーニングを通して思考力と発信力を育てます。平和教育と国際交流、英語学習を組み合わせ、一人ひとりの個性を尊重しながら、他者と協力して社会に関わる力を養います。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12653,"name":"アーチェリー部","category":"運動部","source_url":"https://www.aletheia.ac.jp/jr/schoollife/club.html","verified_at":"2026-08-11"},{"id":12654,"name":"陸上競技部","category":"運動部","source_url":"https://www.aletheia.ac.jp/jr/schoollife/club.html","verified_at":"2026-08-11"},{"id":12655,"name":"硬式テニス部","category":"運動部","source_url":"https://www.aletheia.ac.jp/jr/schoollife/club.html","verified_at":"2026-08-11"},{"id":12656,"name":"吹奏楽部","category":"文化部","source_url":"https://www.aletheia.ac.jp/jr/schoollife/club.html","verified_at":"2026-08-11"},{"id":12657,"name":"漫画研究部","category":"文化部","source_url":"https://www.aletheia.ac.jp/jr/schoollife/club.html","verified_at":"2026-08-11"}],"profile_sources":[{"id":3684,"attribute_key":"feature_summary","source_url":"https://www.aletheia.ac.jp/jr/intro/course.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3685,"attribute_key":"feature_description","source_url":"https://www.aletheia.ac.jp/jr/intro/course.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
