{"id":577,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"知徳体と個性を伸ばす体験型女子教育","feature_description":"藤村女子は、心身の健全さと知・徳・体を兼ね備えた個性豊かな女子の育成を建学の精神とします。6年間を通じて自発的な学びを段階的に深め、教科横断・体験型の授業で非認知スキルを伸ばします。英語とICTを独立した目的ではなく、自分の個性を生かして考え、実行するための道具として位置付けます。吉祥寺の地域とも関わり、社会に開かれた学びをつくることを重視しています。","clubs":[{"id":10774,"name":"ソフトボール部","category":"運動部","source_url":"https://fujimura.ed.jp/junior-high-school/category/club/","verified_at":"2026-08-10"},{"id":10775,"name":"軽音楽部","category":"文化部","source_url":"https://fujimura.ed.jp/junior-high-school/category/club/","verified_at":"2026-08-10"},{"id":10776,"name":"児童文化部","category":"文化部","source_url":"https://fujimura.ed.jp/junior-high-school/category/club/","verified_at":"2026-08-10"}],"profile_sources":[{"id":3476,"attribute_key":"feature_summary","source_url":"https://fujimura.ed.jp/guide/feature/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3477,"attribute_key":"feature_description","source_url":"https://fujimura.ed.jp/guide/feature/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
