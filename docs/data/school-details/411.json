{"id":411,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"心の教育と三コース制で探究を育む","feature_description":"江戸川学園取手中学校は、心豊かなリーダーの育成を掲げ、徳育を重視しています。中学からの入学者は、志望大学や学力に応じた三つのコースで学び、教科の基礎から発展的な内容へ段階的に力を伸ばします。学校行事や体験学習、部活動・ボランティアも教育活動に位置づけられ、学習と社会性を育てる機会を設けています。学園全体の方針として、心身の成長と社会貢献を意識した学びを掲げています。","clubs":[{"id":8051,"name":"サッカー部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8052,"name":"水泳部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8055,"name":"バレーボール部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8057,"name":"陸上競技部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8062,"name":"硬式テニス部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8063,"name":"軟式野球部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"},{"id":8065,"name":"チアリーダー部","category":"運動部","source_url":"https://www2.e-t.ed.jp/about-edotori/club/","verified_at":"2026-11-16"}],"profile_sources":[{"id":1423,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=433","source_kind":"nichinoken","external_school_code":"433","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1424,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=433","source_kind":"nichinoken","external_school_code":"433","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1425,"attribute_key":"lunch_type","source_url":"https://www2.e-t.ed.jp/wp-content/themes/origin/pdf/guide2026ja.pd