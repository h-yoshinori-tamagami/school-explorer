{"id":626,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教精神で個を確立する教育","feature_description":"キリスト教精神で個を確立する教育を教育の中心に据え、教科の学びと学校生活を結び付けながら、生徒が自ら考え行動する力を育てます。基礎となる知識や技能を着実に身に付けるとともに、探究、対話、行事、部活動などの経験を通して、多様な仲間と協働し課題に向き合います。一人ひとりが自分の目標を見つけ、学びを深め、社会や世界に関わる視野を広げられるよう支える教育です。","clubs":[],"profile_sources":[{"id":2133,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=335","source_kind":"nichinoken","external_school_code":"335","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2134,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=335","source_kind":"nichinoken","external_school_code":"335","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2135,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=335","source_kind":"nichinoken","external_school_code":"335","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2136,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=335","source_kind":"nichinoken","external_school_code":"335","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2137,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=335","source_kind":"nichinoken","external_school_code":"335","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2138,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/