{"id":50,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"洛北サイエンスで探究心を伸ばす","feature_description":"京都府立洛北高等学校附属中学校は、洛北サイエンスを特色とし、自然科学への関心と探究する力を育てる中高一貫校です。観察、実験、課題研究などを通して、自ら問いを立てて考える姿勢を大切にします。幅広い学習や学校行事も組み合わせ、論理的に考え、仲間と協働しながら未来を切り拓く力を養います。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":2432,"attribute_key":"feature_summary","source_url":"http://www.kyoto-be.ne.jp/rakuhoku-hs/mt/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2433,"attribute_key":"feature_description","source_url":"http://www.kyoto-be.ne.jp/rakuhoku-hs/mt/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
