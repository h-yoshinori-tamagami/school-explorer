{"id":146,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"感動・理知・友愛の大分豊府中高","feature_description":"大分県立大分豊府中学校は、県立唯一の併設型中高一貫教育校として、学校案内や教育課程、学校生活をまとめて案内しています。部活動ページや学校ニュースから、日々の行事と課外活動の様子を具体的に確認しやすい構成です。 併設型ならではの連続性があり、中高一貫の流れも感じやすいです。 学校ニュースと部活動の両方を追うことで、日常の動きが把握しやすくなります。","clubs":[{"id":2520,"name":"美術部","category":"文化部","source_url":"https://kou.oita-ed.jp/oitahoufutyu/page_students/club/","verified_at":"2026-08-06"},{"id":2521,"name":"演劇部","category":"文化部","source_url":"https://kou.oita-ed.jp/oitahoufutyu/page_students/club/","verified_at":"2026-08-06"},{"id":2522,"name":"吹奏楽部","category":"文化部","source_url":"https://kou.oita-ed.jp/oitahoufutyu/page_students/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2604,"attribute_key":"feature_summary","source_url":"https://kou.oita-ed.jp/oitahoufutyu/school/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2605,"attribute_key":"feature_description","source_url":"https://kou.oita-ed.jp/oitahoufutyu/school/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
