{"id":31,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由な校風と大学連携で主体性を育む","feature_description":"中央大学附属中学校・高等学校は、自由でのびやかな校風の中で、自ら考えて行動する力を育てる大学附属校です。中高6年間の学びでは基礎学力を固めつつ、探究、自治活動、行事、大学との連携を通して視野を広げます。進路を早く絞りすぎず、自分の興味や適性を見つめながら将来を考える姿勢を大切にしています。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[{"id":467,"name":"中学野球部","category":"運動部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":468,"name":"サッカー部","category":"運動部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":469,"name":"水球部","category":"運動部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":470,"name":"ESS部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":471,"name":"合唱部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":472,"name":"コンピュータ部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":473,"name":"美術・書道・文藝部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":474,"name":"吹奏楽部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":475,"name":"生物部（Wild Life）","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":476,"name":"地学研究部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"},{"id":477,"name":"物理部","category":"文化部","source_url":"https://www.hs.chuo-u.ac.jp/school/sc-club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":242,"attribute_key":"religious_background","source_url":"https://chu-fu.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidat