{"id":450,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由な校風と六年一貫教育で自主性を育む灘","feature_description":"灘中学校・高等学校は六ヵ年完全一貫教育を行い、入学時に編成した担任団が卒業まで学年を担当します。授業は中学3年で高校1年の課程を終える進度ですが、復習を重ねる学習や考える力を養う授業、理科実験を重視しています。自由な校風のもと、生徒が自ら判断して行動する自主性を尊重します。学校生活でも強制を控え、規則を最小限にする方針です。","clubs":[],"profile_sources":[{"id":1568,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=770","source_kind":"nichinoken","external_school_code":"770","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1569,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=770","source_kind":"nichinoken","external_school_code":"770","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":"2026-11-15T23:26:10.597892","priority":null},{"id":1570,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=770","source_kind":"nichinoken","external_school_code":"770","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3686,"attribute_key":"feature_summary","source_url":"https://www.nada.ac.jp/enkaku.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3687,"attribute_key":"feature_description","source_url":"https://www.nada.ac.jp/enkaku.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
