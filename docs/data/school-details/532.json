{"id":532,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"四つの柱でリーダーを育む精道教育","feature_description":"精道三川台は、カトリックの教育理念に基づく人格教育を土台に、探究教育、英語実践教育、食育を四つの柱として学びを組み立てます。ケーススタディーや探究活動、発表を通じて、課題を多角的に考え、協働して解決策を示す力を育成します。少人数の英語授業や国際交流、メンターとの継続的な対話も特徴です。自由と責任を校訓に、知性と品格を備え社会に貢献する人を目指します。","clubs":[],"profile_sources":[{"id":1815,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=859","source_kind":"nichinoken","external_school_code":"859","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1816,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=859","source_kind":"nichinoken","external_school_code":"859","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3386,"attribute_key":"feature_summary","source_url":"https://seido.ed.jp/vision/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3387,"attribute_key":"feature_description","source_url":"https://seido.ed.jp/vision/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
