{"id":175,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自由な個人を育てる一条附属中学","feature_description":"奈良市立一条高等学校附属中学校は、自由に生きることができる「個人」を育成することを掲げ、特色ある学習や入学希望者向け案内を整えています。学校説明やe-オープンスクールも案内されており、6年間の学びの入口が分かりやすい学校です。 一条ACEや特色ある学習の案内もあり、6年間を通じて自分の学び方を育てる方針が見えます。 学校紹介動画や説明会案内もあり、入学希望者への情報提供が手厚いです。","clubs":[],"profile_sources":[{"id":2732,"attribute_key":"feature_summary","source_url":"https://www.ichijo.ed.jp/%E9%99%84%E5%B1%9E%E4%B8%AD%E5%AD%A6%E6%A0%A1","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2733,"attribute_key":"feature_description","source_url":"https://www.ichijo.ed.jp/%E9%99%84%E5%B1%9E%E4%B8%AD%E5%AD%A6%E6%A0%A1","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
