{"id":59,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"中等教育で主体性と進路意識を育む","feature_description":"仙台市立仙台青陵中等教育学校は、6年間を見通した中等教育の中で、学力と人間性を段階的に育てる公立中高一貫校です。学校生活や探究的な学習を通して、自ら考え、周囲と協働し、将来の進路を主体的に選ぶ力を養います。仙台市の公式情報に基づき、地域に根ざした教育活動を行う学校として整理しています。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":1201,"name":"美術","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"},{"id":1202,"name":"合唱","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"},{"id":1203,"name":"吹奏楽","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"},{"id":1204,"name":"文芸","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"},{"id":1205,"name":"科学","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"},{"id":1206,"name":"放送","category":"文化部","source_url":"https://www.city.sendai.jp/kokokyoiku/kurashi/manabu/kyoiku/inkai/kanren/documents/2025_seiryou.pdf","verified_at":"2026-08-06"}],"profile_sources":[{"id":2450,"attribute_key":"feature_summary","source_url":"https://www.city.sendai.jp/sesakukoho/kurashi/shisetsu/kyoiku/chugakko/kyoiku-chuto/1775.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2451,"attribute_key":"feature_description","source_url":"https://www.city.sendai.jp/sesakukoho/kurashi/shisetsu/kyoiku/chugakko/kyoiku-chuto/1775.html","source_kind":"official_site","external_school_code":null,"verif