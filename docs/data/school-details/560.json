{"id":560,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"クラス選択と個人課題研究で探究する","feature_description":"茗溪学園はMG・AC・IC・IBなど学び方を選べるクラス編成を設け、教科の授業に探究・研修を組み合わせます。個人課題研究では、生徒がテーマを決めて一年間調査・考察し、論文と発表にまとめます。英語で主要科目を学ぶIC、幅広い科目選択を行うIBなど、目標に応じた環境があります。研修旅行では企業訪問や現地大学生との交流を行い、実社会に触れて将来を考えます。","clubs":[{"id":10606,"name":"ラグビー部（中学）","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-11-16"},{"id":10607,"name":"剣道部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/kendo/","verified_at":"2026-11-16"},{"id":10608,"name":"テニス部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/tennis/","verified_at":"2026-11-16"},{"id":10609,"name":"バドミントン部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/badminton/","verified_at":"2026-11-16"},{"id":10610,"name":"科学部無線工学班","category":"文化部","source_url":"https://meikei.ac.jp/traits/club/science-radio/","verified_at":"2026-11-16"},{"id":10611,"name":"吹奏楽部","category":"文化部","source_url":"https://meikei.ac.jp/traits/club/wind-orchestra/","verified_at":"2026-11-16"},{"id":10612,"name":"茶道同好会","category":"同好会・愛好会","source_url":"https://meikei.ac.jp/traits/club/tea-ceremony/","verified_at":"2026-11-16"}],"profile_sources":[{"id":1924,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=434","source_kind":"nichinoken","external_school_code":"434","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1925,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=434","source_kind":"nichinoken","external_school_code":"434","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1926,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/in