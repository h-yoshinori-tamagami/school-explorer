{"id":560,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"多彩なコースと探究で挑戦を支える学園","feature_description":"茗溪学園中学校は、茗溪ジェネラル、アカデミア、国際バカロレアの各クラスや、SSH、個人課題研究、国内・海外研修を通じて、多様な進路と学び方を用意しています。課外活動では、全国大会を目指す部活動から、趣味や探究心を深める同好会まで幅広い選択肢があります。学業との両立を図りながら、自ら考え、創意工夫し、目標へ向け努力する過程を重視し、一人ひとりの関心や目標に寄り添う挑戦の場をつくる学校です。","clubs":[{"id":10606,"name":"ラグビー部（中学）","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10607,"name":"剣道部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10608,"name":"テニス部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10609,"name":"バドミントン部","category":"運動部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10610,"name":"科学部無線工学班","category":"文化部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10611,"name":"吹奏楽部","category":"文化部","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"},{"id":10612,"name":"茶道同好会","category":"同好会・愛好会","source_url":"https://meikei.ac.jp/traits/club/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1924,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=434","source_kind":"nichinoken","external_school_code":"434","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1925,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=434","source_kind":"nichinoken","external_school_code":"434","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1926,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=434","source_kind":"nichinok