{"id":155,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"運動部が強い浪商中の文武両道教育","feature_description":"大阪体育大学浪商中学校は、自分の進路実現に向けて2年次にプログラムを選び、特色ある授業で学ぶ学校です。クラブ活動にも力を入れ、生徒の約9割が参加し、体育大の設備を生かした練習環境が用意されています。学習と競技を両立しやすい設計が明快です。 大阪体育大学の施設を生かした練習環境と、教科ごとの特色ある授業がつながるため、競技面と学習面を同時に伸ばしやすい学校です。","clubs":[{"id":2940,"name":"硬式野球部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2941,"name":"ハンドボール部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2942,"name":"体操部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2943,"name":"水泳部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2944,"name":"陸上競技部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2945,"name":"レスリング部","category":"運動部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2946,"name":"美術部","category":"文化部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"},{"id":2947,"name":"吹奏楽部","category":"文化部","source_url":"https://www.ouhs-school.jp/ouhsjhs/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2648,"attribute_key":"feature_summary","source_url":"https://www.ouhs-school.jp/ouhsjhs/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2649,"attribute_key":"feature_description","source_url":"https://www.ouhs-school.jp/ouhsjhs/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
