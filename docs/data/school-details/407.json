{"id":407,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"地球学と探究で国際社会のリーダーを育てる","feature_description":"東京都立武蔵高等学校・附属中学校は、伝統の向上進取の精神を大切にし、国際社会に貢献する知性豊かなリーダーを育てます。中学校では自然・人間・社会を横断する「地球学」で課題発見・解決力を養い、発展的な授業や少人数指導、キャリア教育など6年間の一貫教育を展開しています。中学校では45分7時間授業で学習機会を確保し、国際機関等と連携した英語体験やキャリア教育にも取り組みます。","clubs":[{"id":14690,"name":"陸上競技部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14691,"name":"ラグビー部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14692,"name":"サッカー部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14693,"name":"男子バレーボール部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14694,"name":"女子バスケットボール部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14695,"name":"女子バレーボール部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14696,"name":"男子硬式テニス部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14697,"name":"女子硬式テニス部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14698,"name":"卓球部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14699,"name":"剣道部","category":"運動部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14700,"name":"吹奏楽部","category":"文化部","source_url":"https://www.metro.ed.jp/musashi-h/school_life/activities.html","verified_at":"2026-11-16"},{"id":14701,"na