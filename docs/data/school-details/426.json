{"id":426,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"6年一貫で夢を学ぶ浦和学院中学校","feature_description":"浦和学院中学校は、「吾道一貫」に基づき一人ひとりの未知なる可能性を引き出す6年一貫校です。国際教養力、ライフスキル、デジタルテクノロジー活用力の三つの力を軸に、学習とキャリアの両面を支えています。スクールライフでは部活一覧を公開し、放課後の活動も学校の魅力として案内しています。新設校として学びの設計が明快で、設置予定の部活動も具体的に示されています。","clubs":[{"id":8429,"name":"テニス部","category":"運動部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8430,"name":"卓球部","category":"運動部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8431,"name":"吹奏楽部","category":"文化部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8432,"name":"ボイスワークス部","category":"文化部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8433,"name":"アートクリエイト部","category":"文化部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8434,"name":"ランゲージ＆カルチャー部","category":"文化部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8435,"name":"サイエンステクノロジー部","category":"文化部","source_url":"https://ugj.jp/clublist/%E3%81%9D%E3%81%AE%E4%BB%96/","verified_at":"2026-08-07"},{"id":8436,"name":"女子フラッグフットボール","category":"運動部","source_url":"https://ugj.jp/clublist/%E5%A5%B3%E5%AD%90%E3%83%95%E3%83%A9%E3%83%83%E3%82%B0%E3%83%95%E3%83%83%E3%83%88%E3%83%9C%E3%83%BC%E3%83%AB/","verified_at":"2026-08-07"},{"id":8437,"name":"スケートボード","category":"運動部","source_url":"https://ugj.jp/clublist/%E3%82%B9%E3%82%B1%E3%83%BC%E3%83%88%E3%83%9C%E3%83%BC%E3%83%89/","verified_at":"2026-08-07"}],"profile_sources":[{"id":1465,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=497","source_kind":"nichinoken","external_school_code":"497","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_h