{"id":243,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"高水準授業と英語環境が強みの広尾","feature_description":"広尾学園は、教育の特色として高水準の授業、抜群の英語環境、勉学と部活動の両立を掲げています。中学・高校それぞれの案内で、学力保証の仕組みと挑戦を支える学園文化が明示されており、進路実現と学校生活の両面を重視していることが分かります。V-P.L.T.やP.L.T.の学習設計も案内され、目標別の学び方が分かります。P.L.T.など学習の流れも見えます。","clubs":[{"id":5275,"name":"バスケットボール部","category":"運動部","source_url":"https://www.hiroogakuen.ed.jp/info/club.html","verified_at":"2026-08-06"},{"id":5276,"name":"吹奏楽部","category":"文化部","source_url":"https://www.hiroogakuen.ed.jp/info/club_culture.html","verified_at":"2026-08-06"},{"id":5277,"name":"美術部","category":"文化部","source_url":"https://www.hiroogakuen.ed.jp/info/club_culture.html","verified_at":"2026-08-06"}],"profile_sources":[{"id":912,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=118","source_kind":"nichinoken","external_school_code":"118","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":913,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=118","source_kind":"nichinoken","external_school_code":"118","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":914,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=118","source_kind":"nichinoken","external_school_code":"118","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":915,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=118","source_kind":"nichinoken","external_school_code":"118","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"