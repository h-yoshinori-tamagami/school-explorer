{"id":169,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"韓国語英語で育つ金剛インター校","feature_description":"大阪金剛インターナショナル中学校は、韓国語と英語を学び、韓国の教育カリキュラムも取り入れた国際色の強い学校です。公式サイトでは、トリリンガル教育とグローバルリーダー育成を掲げ、部活動も活発であることが確認できました。 テコンドーや舞踊、韓国語・英語の活動が並び、文化的背景を生かした学びの広がりも見えます。 部活動紹介も整っており、生徒が国際舞踊やテコンドーに親しめる環境が分かります。","clubs":[{"id":3596,"name":"テコンドー部","category":"運動部","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3597,"name":"舞踊部","category":"文化部","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3598,"name":"テニス部","category":"運動部","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3599,"name":"サッカー部","category":"運動部","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3600,"name":"バスケットボール部","category":"運動部","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3601,"name":"卓球同好会","category":"同好会・愛好会","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3602,"name":"K-POPダンス同好会","category":"同好会・愛好会","source_url":"https://www.kongogakuen.ed.jp/middle/club_middle/","verified_at":"2026-08-06"},{"id":3603,"name":"サムルノリ部","category":"文化部","source_url":"https://www.kongogakuen.ed.jp/%E6%96%87%E5%8C%96%E7%A5%AD%EF%BC%81%EF%BC%812021-09-19-2021-09-20/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2728,"attribute_key":"feature_summary","source_url":"https://www.kongogakuen.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2729,"attribute_key":"feature_description","source_url":"https://www.kongogakuen.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":nul