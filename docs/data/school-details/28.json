{"id":28,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"寄宿舎と自然の中で自立を育む女子校","feature_description":"不二聖心女子学院中学校・高等学校は、聖心の教育理念を受け継ぎ、寄宿舎を含む学校生活の中で自立心、思いやり、社会に向き合う姿勢を育てます。自然に恵まれた環境を生かし、祈りや奉仕、探究的な学び、英語教育を通じて、知性と品格を備えた女性の成長を支える学校です。少人数の関わりも大切にしています。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":213,"attribute_key":"religious_background","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":214,"attribute_key":"dormitory_available","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":215,"attribute_key":"uniform_policy","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":216,"attribute_key":"affiliation_name","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":217,"attribute_key":"lunch_type","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":218,"attribute_key":"affiliation_type","source_url":"https://www.fujiseishin-js.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":219,"attribu