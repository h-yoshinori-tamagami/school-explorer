{"id":531,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"学びと課外活動を結ぶ自主自立の教育","feature_description":"箕面自由学園は、学習・規律やマナー・課外活動の調和を通じ、生徒の自由でのびのびとした個性を生かしながら自主自立の精神を育てる学校です。総合的な探究や課題研究、地域・社会との連携で課題を発見し解決に向かう学びを進め、学校行事や部活動も教科学習と結び付けています。多様な選択科目と進路指導を組み合わせ、他者を尊重し協働する力を養います。個々の状況に応じた丁寧な支援も重視しています。","clubs":[],"profile_sources":[{"id":1810,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=720","source_kind":"nichinoken","external_school_code":"720","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1811,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=720","source_kind":"nichinoken","external_school_code":"720","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1812,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=720","source_kind":"nichinoken","external_school_code":"720","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1813,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=720","source_kind":"nichinoken","external_school_code":"720","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1814,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=720","source_kind":"nichinoken","external_school_code":"720","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3384,"attribute_key":"feature_summary","source_url":"https://mino-jiyu.