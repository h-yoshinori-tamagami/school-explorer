{"id":75,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"英語と体験で世界へ伸びる中高一貫教育","feature_description":"八雲学園中学校・高等学校は、英語教育や多様な体験を通して、国際的な視野と主体性を育てる学校です。日々の授業、学校行事、探究的な活動を組み合わせ、自分の考えを表現し、他者と協働する力を伸ばします。中高一貫の環境で、生徒が将来の可能性を広げる学びを大切にしています。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":1314,"name":"高校女子バスケットボール部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1315,"name":"中学女子バスケットボール部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1316,"name":"中学男子バスケットボール部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1317,"name":"高校男子バスケットボール部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1318,"name":"空手道部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1319,"name":"剣道部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"},{"id":1320,"name":"中学硬式テニス部","category":"運動部","source_url":"https://www.yakumo.ac.jp/club_report/","verified_at":"2026-08-06"}],"profile_sources":[{"id":432,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=178","source_kind":"nichinoken","external_school_code":"178","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":433,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=178","source_kind":"nichinoken","external_school_code":"178","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":434,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=178","sourc