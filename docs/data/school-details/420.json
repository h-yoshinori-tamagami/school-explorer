{"id":420,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"頭・心・身体を育てる学業・部活動・行事","feature_description":"浅野学園は学業・部活動・学校行事を三本柱とし、頭と心と身体をバランスよく育てる。学力だけでなく、学年を越えた交流や仲間と目標に向かって協働する経験を大切にし、自分の生き方や人生の動機を見つける機会を設ける。校訓「九転十起」と「愛と和」のもと、失敗を恐れず努力を重ね、他者への思いやりや協働力を育む。中学・高校の6年間を人間形成の場と位置づける。","clubs":[{"id":15201,"name":"剣道部","category":"運動部","source_url":"https://www.asano.ed.jp/information/11838/","verified_at":"2026-11-20"},{"id":15202,"name":"ハンドボール部","category":"運動部","source_url":"https://www.asano.ed.jp/information/11789/","verified_at":"2026-11-20"},{"id":15203,"name":"陸上競技部","category":"運動部","source_url":"https://www.asano.ed.jp/sports/athletic/","verified_at":"2026-11-20"},{"id":15204,"name":"卓球部","category":"運動部","source_url":"https://www.asano.ed.jp/sports/table_tennis/","verified_at":"2026-11-20"},{"id":15205,"name":"野球部","category":"運動部","source_url":"https://www.asano.ed.jp/sports/baseball/","verified_at":"2026-11-20"},{"id":15206,"name":"テニス部","category":"運動部","source_url":"https://www.asano.ed.jp/information/11746/","verified_at":"2026-11-20"}],"profile_sources":[{"id":1455,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=308","source_kind":"nichinoken","external_school_code":"308","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1456,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=308","source_kind":"nichinoken","external_school_code":"308","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1457,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=308","source_kind":"nichinoken","external_school_code":"308","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"c