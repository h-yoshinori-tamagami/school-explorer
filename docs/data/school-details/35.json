{"id":35,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"啐啄同時の心で可能性を伸ばす教育","feature_description":"中部大学春日丘中学校は、中部大学併設の中高一貫校として、生徒の可能性を引き出す教育を行っています。教育理念に掲げる「啐啄同時」の姿勢を大切にし、基礎学力、探究心、礼節、協働する力を育てます。大学とのつながりや体験的な学びも生かし、自ら学び続ける姿勢と将来を切り拓く力を養います。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[{"id":521,"name":"テニス部","category":"運動部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":522,"name":"ハンドボール部","category":"運動部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":523,"name":"陸上競技部","category":"運動部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":524,"name":"バスケットボール部","category":"運動部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":525,"name":"合唱部","category":"文化部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":526,"name":"コンピュータ部","category":"文化部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":527,"name":"科学部","category":"文化部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"},{"id":528,"name":"美術部","category":"文化部","source_url":"https://www.haruhigaoka.ed.jp/junior/life/club.html","verified_at":"2026-08-06"}],"profile_sources":[{"id":281,"attribute_key":"religious_background","source_url":"https://www.haruhigaoka.ed.jp/junior/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":282,"attribute_key":"dormitory_available","source_url":"https://www.haruhigaoka.ed.jp/junior/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":