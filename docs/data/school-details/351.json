{"id":351,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"夢の実現へ基礎学力と実学を育てる中等部","feature_description":"東京農業大学第一高等学校中等部は、6年間の中高一貫校です。「夢の創造と実現」を教育目標に、中学3年間を生活習慣を身につけ、夢を見つけ育て、人格を形成し、基礎学力と基礎体力を養う期間と位置づけています。世界で通用する学力や心の教育、国際化を重視し、実物にふれ、体験し、考え実行する実学教育を通して、夢の実現に向けて力を発揮できる生徒を育てます.","clubs":[{"id":6342,"name":"卓球","category":"運動部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6349,"name":"吹奏楽","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6350,"name":"演劇","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6353,"name":"書道","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6354,"name":"化学","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6355,"name":"美術","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6357,"name":"茶道","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6360,"name":"華道","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6363,"name":"生物","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":6365,"name":"写真","category":"文化部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":13152,"name":"軟式野球（中等部）","category":"運動部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":13153,"name":"柔道","category":"運動部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":13154,"name":"剣道","category":"運動部","source_url":"https://www.nodai-1-h.ed.jp/?page_id=737","verified_at":"2026-11-15"},{"id":13155,"name":"ラグビー","category":"運動部","source_url":"http