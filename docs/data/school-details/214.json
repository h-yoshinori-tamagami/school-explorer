{"id":214,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"仏教精神で未来を拓く岐阜聖徳附属","feature_description":"岐阜聖徳学園大学附属中学校は、仏教精神を基調に心豊かな人間性と確固たる倫理観を育み、人格の完成をめざす学校です。高い志、自主性、社会性、創造性を備えた、環境適応力の高いグローバル人材の育成を教育方針として掲げています。教育理念と方針がはっきり示されている点が特徴で、実習や探究の流れも確認でき、部活動や行事も支えています。","clubs":[{"id":4696,"name":"バスケットボール部","category":"運動部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4697,"name":"バドミントン部","category":"運動部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4698,"name":"テニス部(硬式)","category":"運動部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4699,"name":"卓球部","category":"運動部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4700,"name":"合唱部","category":"文化部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4701,"name":"ディベート部","category":"文化部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4702,"name":"茶華道部","category":"文化部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4703,"name":"囲碁将棋部","category":"文化部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"},{"id":4704,"name":"総合美術部(イラスト・美術・光画)","category":"文化部","source_url":"https://www.shotoku.ac.jp/jh/schoollife/club.html","verified_at":"2026-08-06"}],"profile_sources":[{"id":2860,"attribute_key":"feature_summary","source_url":"https://www.shotoku.ac.jp/jh/outline/foundation.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2861,"attribute_key":"feature_description","source_url":"https://www.shotoku.ac.jp/jh/outline/foundation.html","source_kind":"officia