{"id":229,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"文武両道と親心で磨く巣鴨の学び","feature_description":"巣鴨学園は、100年を超える伝統の中で受け継がれてきた文武両道の精神を大切にしています。『親心』に基づく家庭的温情と厳格さで生徒を磨き、時代が変わっても活躍する真の人材を育てるという方針が公式サイトで示されています。英才早教育の考え方や、海外を見据えた英語教育の案内もあります。難関大進学を見据えた6年一貫の説明もあります。","clubs":[{"id":4971,"name":"JRC同好会","category":"文化部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4972,"name":"クイズ同好会","category":"文化部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4973,"name":"社会同好会","category":"文化部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4974,"name":"数学同好会","category":"文化部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4975,"name":"バスケットボール部","category":"運動部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4976,"name":"サッカー部","category":"運動部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"},{"id":4977,"name":"硬式テニス部","category":"運動部","source_url":"https://www.sugamo.ed.jp/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":867,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=228","source_kind":"nichinoken","external_school_code":"228","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":868,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=228","source_kind":"nichinoken","external_school_code":"228","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":869,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=228","source_kind":"nichinoken","external_school_code":"228","verified_at":"2026-08-04","source_excerpt":n