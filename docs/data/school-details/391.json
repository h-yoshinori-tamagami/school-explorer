{"id":391,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自ら課題を見つける附属横浜の学び","feature_description":"横浜国立大学附属横浜中学校は、教育目標で「自ら課題を見つけ、その解決のために主体的に判断し行動する力」を掲げる学校です。TOFYやi-ハーベストなどの学習活動を軸に、大学との連携や学校生活の場面を通して、考える力と協働する力を育てます。自分で学びを組み立てる姿勢が育ちやすい点が特徴です。学校生活と学習研究がつながる構成です。","clubs":[{"id":7336,"name":"ラケット使用ネット型球技","category":"運動部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7337,"name":"ラケット不要ネット型球技","category":"運動部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7338,"name":"個人種目運動","category":"運動部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7339,"name":"ゴール型球技","category":"運動部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7340,"name":"ベースボール型球技","category":"運動部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7341,"name":"身体表現探究","category":"文化部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7342,"name":"音楽探究","category":"文化部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7343,"name":"自然科学探究","category":"文化部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7344,"name":"造形探究","category":"文化部","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"},{"id":7345,"name":"文化交流","category":"その他","source_url":"https://yokochu.ynu.ac.jp/club/","verified_at":"2026-08-07"}],"profile_sources":[{"id":3114,"attribute_key":"feature_summary","source_url":"https://yokochu.ynu.ac.jp/mission","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3115,"attribute_key":"feature_description","source_url":"https://yokochu.ynu.ac.jp/mission","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt