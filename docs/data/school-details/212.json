{"id":212,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"志教育で挑戦力を育む山脇学園中高","feature_description":"山脇学園中学校・高等学校は、『志』教育を軸に、主体的に生きる力と自ら求めて深く学ぶ姿勢を育てています。6年間の学びの中で、フォローアップ、グローバル教育、サイエンス教育など多様な学びを組み合わせていることが公式サイトで確認できます。チャレンジとアクションの方針も明示され、探究と進路支援の両面が見えます。学園全体の学びの設計が分かります。","clubs":[{"id":4694,"name":"写真同好会","category":"文化部","source_url":"https://www.yamawaki.ed.jp/school-life/club/","verified_at":"2026-08-06"},{"id":4695,"name":"弦楽同好会","category":"文化部","source_url":"https://www.yamawaki.ed.jp/school-life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":830,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=120","source_kind":"nichinoken","external_school_code":"120","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":831,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=120","source_kind":"nichinoken","external_school_code":"120","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":832,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=120","source_kind":"nichinoken","external_school_code":"120","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":833,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=120","source_kind":"nichinoken","external_school_code":"120","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2856,"attribute_key":"feature_summary","source_url":"https://www.yamawaki.ed.jp/education/","source_kind":"official_site","external_school_code":null,"