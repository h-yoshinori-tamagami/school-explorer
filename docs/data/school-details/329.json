{"id":329,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"愛のある教育で誠実明朗を育てる","feature_description":"智辯学園奈良カレッジ中学部・高等部は、『愛のある教育』を原点に、誠実・明朗で心豊かな人物の育成をめざす学校です。生徒一人ひとりを献身的に支え、学力の徹底と人間性の成長を両立させます。中高一貫で将来を見据えた学びができる点が特徴です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[],"profile_sources":[{"id":2968,"attribute_key":"feature_summary","source_url":"https://www.chiben.ac.jp/naracollege/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2969,"attribute_key":"feature_description","source_url":"https://www.chiben.ac.jp/naracollege/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
