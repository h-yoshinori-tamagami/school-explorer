{"id":551,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究・国際・女子教育で自立を育む学び","feature_description":"育英西中学校は、「豊かな教養と純真な人間愛をもって、社会に貢献できる女性の育成」を教育理念に掲げます。敬・愛・信の心を教育の根幹に置き、知性・情操・健康の調和と、他者の違いを受け入れ尊重する姿勢を大切にします。探究教育、グローバル教育、女子教育を組み合わせ、自ら課題を発見して考え、周囲と関わりながら行動できる女性を育てます。国際的な教養と、自ら未来を切り拓く力を目指す教育です。","clubs":[{"id":10526,"name":"テニス部","category":"運動部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10527,"name":"バスケットボール部","category":"運動部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10528,"name":"バドミントン部","category":"運動部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10529,"name":"陸上競技部","category":"運動部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10530,"name":"サイエンス部","category":"文化部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10531,"name":"音楽部（合唱）","category":"文化部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"},{"id":10532,"name":"競技かるた部","category":"文化部","source_url":"https://www.ikuei.ed.jp/ikunishi/topics/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1878,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=637","source_kind":"nichinoken","external_school_code":"637","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1879,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=637","source_kind":"nichinoken","external_school_code":"637","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1880,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php