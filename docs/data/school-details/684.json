{"id":684,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"六年間を通じて知性と社会への関心を育てる","feature_description":"千葉県立千葉中学校は県立千葉高等学校に併設され、六年間を見通した教育を行います。教育目標には、自ら学び続けて知性を高めること、他者と協力しながら豊かな人間性を養うこと、社会に貢献する志を育てることを掲げています。学力を土台に幅広い教養を深め、日本の伝統や文化、実社会への理解を重ねます。校地は本千葉駅から徒歩圏にあり、周辺には県立中央図書館などの文化施設があります。","clubs":[],"profile_sources":[{"id":3813,"attribute_key":"feature_summary","source_url":"https://cms1.chiba-c.ed.jp/chiba-j/school-overview/SchoolOutline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3814,"attribute_key":"feature_description","source_url":"https://cms1.chiba-c.ed.jp/chiba-j/school-overview/SchoolOutline","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3820,"attribute_key":"lunch_type","source_url":"https://cms1.chiba-c.ed.jp/chiba-j/wysiwyg/file/download/1/10900","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-20","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
