{"id":266,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"奉仕の心を育てる愛徳学園中高一貫","feature_description":"校訓の「気高く、強く、美しく」を軸に、カトリック・ミッションスクール、少人数教育、Rainbow Programで女性の成長を支えています。自ら考え、人に奉仕し、充実した人生を歩む女性の育成を掲げ、学校生活全体を通して人間性を育てる構成です。教育方針と学校生活の関係が見えやすい学校です。学校紹介、学校生活、部活動の導線が整理され、比較しやすい構成です。","clubs":[],"profile_sources":[{"id":974,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=764","source_kind":"nichinoken","external_school_code":"764","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":975,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=764","source_kind":"nichinoken","external_school_code":"764","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":976,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=764","source_kind":"nichinoken","external_school_code":"764","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":977,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=764","source_kind":"nichinoken","external_school_code":"764","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":978,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=764","source_kind":"nichinoken","external_school_code":"764","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2764,"attribute_key":"feature_summary","source_url":"https://high.aitokugakuen.