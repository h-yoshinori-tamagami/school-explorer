{"id":433,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究と進路支援を結ぶ女子一貫教育","feature_description":"淑徳与野中学校は、きめ細かな指導と中高一貫のカリキュラムを基盤に、主体的に学ぶ姿勢を育てます。創作・研究、職業体験、研究小論文、ディベートなどを通じて、考える力・判断する力・表現する力を伸ばす方針です。キャリア教育では自分の体験や将来像を振り返り、他者と目標を共有しながら進路を切り拓く力を養います。多様な進路選択に対応します。","clubs":[],"profile_sources":[{"id":1496,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=470","source_kind":"nichinoken","external_school_code":"470","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1497,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=470","source_kind":"nichinoken","external_school_code":"470","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1498,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=470","source_kind":"nichinoken","external_school_code":"470","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1499,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=470","source_kind":"nichinoken","external_school_code":"470","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1500,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=470","source_kind":"nichinoken","external_school_code":"470","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1501,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/school