{"id":241,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"学習支援と生徒主体を両立する常翔","feature_description":"常翔学園高等学校は、学習サポートやオリエンテーションを通じて、自律的に学ぶ姿勢を支える学校です。学校案内では教育理念・方針、教育内容、部活動まで一体で案内されており、学習とクラブ活動の両立を後押しする学校生活が見えてきます。生徒主体の活動を支える点も特徴で、放課後学習支援の案内や学校生活の情報発信が充実しています。中高連携の動きも具体的です。","clubs":[{"id":5247,"name":"男子バレーボール部","category":"運動部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5248,"name":"ラグビー部","category":"運動部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5249,"name":"空手道部","category":"運動部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5250,"name":"写真部","category":"文化部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5251,"name":"情報技術研究部","category":"文化部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5252,"name":"剣道部","category":"運動部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5253,"name":"放送部","category":"文化部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"},{"id":5254,"name":"競技かるた部","category":"文化部","source_url":"https://www.josho.ac.jp/flow/vivid_club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":900,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=756","source_kind":"nichinoken","external_school_code":"756","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":901,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=756","source_kind":"nichinoken","external_school_code":"756","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":902,"attribute_key":"affilia