{"id":392,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自主・自律を育てる探究教育の附属鎌倉中","feature_description":"附属鎌倉小中学校は「自立に向けてたくましく生きる」を共通の教育目標に掲げ、自分の関心を見つけ、責任をもって取り組む自主・自律の姿勢を育てます。失敗を振り返って改善につなげる学びや、子どもの思いに寄り添う行事・授業を重視しています。小中9年間の一貫した教育課程を進め、総合的な学習「LIFE」を中心にESDの理念を各教科等に取り入れています。","clubs":[{"id":7346,"name":"バスケットボール部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":7347,"name":"硬式テニス部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":7348,"name":"卓球部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":7349,"name":"バドミントン部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":7350,"name":"陸上競技部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":7351,"name":"野球部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15020,"name":"剣道部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15021,"name":"柔道部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15022,"name":"サッカー部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15023,"name":"吹奏楽部","category":"文化部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15024,"name":"科学部","category":"文化部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"},{"id":15025,"name":"美術部","category":"文化部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-11-19"}],"profile_sources":[{"id":3116,"attribute_key":"feature_summary","source_url":"https://kamachu.ynu.ac.jp/mission","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-19","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,