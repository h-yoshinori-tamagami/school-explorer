{"id":392,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"緑豊かな鎌倉で自立を育む附属中","feature_description":"横浜国立大学附属鎌倉中学校は、鶴岡八幡宮に隣接する緑豊かな環境の中で、自主的に学びを深める学校です。教育目標では、自立や他者との協調、課題解決を重んじており、学校生活の中で学びを積み重ねる姿勢が見えます。静かな環境で落ち着いて学びたい生徒に向いた構成です。部活動も学校生活の一部として位置づけられています。学習と人間形成を両立しやすいです。","clubs":[{"id":7346,"name":"バスケットボール部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"},{"id":7347,"name":"硬式テニス部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"},{"id":7348,"name":"卓球部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"},{"id":7349,"name":"バドミントン部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"},{"id":7350,"name":"陸上競技部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"},{"id":7351,"name":"野球部","category":"運動部","source_url":"https://kamachu.ynu.ac.jp/club","verified_at":"2026-08-07"}],"profile_sources":[{"id":3116,"attribute_key":"feature_summary","source_url":"https://kamachu.ynu.ac.jp/mission","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3117,"attribute_key":"feature_description","source_url":"https://kamachu.ynu.ac.jp/mission","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
