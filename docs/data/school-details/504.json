{"id":504,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"小中連携で創造実践を育てる小倉附属","feature_description":"福岡教育大学附属小倉中学校は、大学附属校として教育研究と教育実習の場を担いながら、小中連携教育を柱に学びを進めています。体育大会や附中祭などの学校行事では生徒が主体的に関わり、学校生活全体で実践力を育てます。部活動も学校生活の重要な場として位置づけられ、運動部・文化部の活動が明示されています。学びの幅と学校生活の厚みを感じやすいです。","clubs":[{"id":9957,"name":"野球部","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9958,"name":"サッカー部","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9959,"name":"陸上部","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9960,"name":"バスケットボール部(男子・女子)","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9961,"name":"女子バレー部","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9962,"name":"剣道部","category":"運動部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9963,"name":"吹奏楽部","category":"文化部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9964,"name":"美術部","category":"文化部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"},{"id":9965,"name":"文芸部","category":"文化部","source_url":"https://kokurajs.fukuoka-edu.ac.jp/schoollife/club.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":3330,"attribute_key":"feature_summary","source_url":"https://kokurajs.fukuoka-edu.ac.jp/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3331,"attribute_key":"feature_description","source_url":"https://kokurajs.fukuoka-edu.ac.jp/ed