{"id":549,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教教育で育む問題解決への挑戦","feature_description":"聖望学園は、神を敬い人を愛するキリスト教主義教育を通じ、社会や組織の問題に正面から取り組む知恵と勇気を備えた人物の育成を目指す中高一貫校です。基礎学力を養いながら、考える力、創造する力、国際感覚、協調性を育てることを教育目標に掲げています。クラブ活動は高校・中学校ともに運動部と文化部がそろい、学習以外の場でも仲間と切磋琢磨する機会があります。海外留学や学園生活のプログラムも用意されています。","clubs":[{"id":10516,"name":"サッカー部","category":"運動部","source_url":"https://www.seibou.ac.jp/club/","verified_at":"2026-08-08"},{"id":10517,"name":"アメリカンフットボール部","category":"運動部","source_url":"https://www.seibou.ac.jp/club/","verified_at":"2026-08-08"},{"id":10518,"name":"ホッケー部","category":"運動部","source_url":"https://www.seibou.ac.jp/club/","verified_at":"2026-08-08"},{"id":10519,"name":"ハンドベルクワイア","category":"文化部","source_url":"https://www.seibou.ac.jp/club/","verified_at":"2026-08-08"},{"id":10520,"name":"ハイスクールYMCA部（Hi-Y部）","category":"文化部","source_url":"https://www.seibou.ac.jp/club/","verified_at":"2026-08-08"}],"profile_sources":[{"id":1873,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=462","source_kind":"nichinoken","external_school_code":"462","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1874,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=462","source_kind":"nichinoken","external_school_code":"462","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1875,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=462","source_kind":"nichinoken","external_school_code":"462","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1876,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.