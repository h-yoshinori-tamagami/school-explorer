{"id":511,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"舞プログラムで育つ誠和の一貫教育","feature_description":"福岡舞鶴誠和中学校は、誠和コース6カ年の一貫教育を軸に、舞プログラムと舞プランで学習を支えます。チーム担任制で生徒を見守り、学業と部活動を両立しながら、先生と協力して伸びる姿勢が特徴です。公式サイトではイベントカレンダーや進路実績も整っています。日々の学習を支える仕組みが明確です。日々の積み重ねで自分の役割を見つけ、学習と活動を両立しやすい環境です。学校生活の見通しも立てやすいです。","clubs":[],"profile_sources":[{"id":1731,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=840","source_kind":"nichinoken","external_school_code":"840","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1732,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=840","source_kind":"nichinoken","external_school_code":"840","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1733,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=840","source_kind":"nichinoken","external_school_code":"840","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1734,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=840","source_kind":"nichinoken","external_school_code":"840","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3344,"attribute_key":"feature_summary","source_url":"https://fmaizuru.ed.jp/junior/learning/program.html","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3345,"attribute_key":"feature_description","source_url":"https://fmaizuru.ed.jp/junior/lear