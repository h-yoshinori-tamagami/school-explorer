{"id":343,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際教養と課題解決学習を軸にする附属校","feature_description":"東京学芸大学附属国際中等教育学校は、「世界に生きる学力と教養」など四つの教育目標を掲げています。国際バカロレアの考えをもとにした国際教養の学習領域を設け、国際理解・人間理解・理数探究を6年間で学びます。課題解決学習を重視し、英語の少人数・習熟度別授業や、海外での学習経験がある生徒への日本語・教科学習支援も行っています。","clubs":[],"profile_sources":[{"id":1204,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=914","source_kind":"nichinoken","external_school_code":"914","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":"2026-11-16T03:57:47.450020","priority":null},{"id":1205,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=914","source_kind":"nichinoken","external_school_code":"914","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1206,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=914","source_kind":"nichinoken","external_school_code":"914","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3028,"attribute_key":"feature_summary","source_url":"https://www.iss.oizumi.u-gakugei.ac.jp/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3029,"attribute_key":"feature_description","source_url":"https://www.iss.oizumi.u-gakugei.ac.jp/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
