{"id":646,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究と体験から自律心を育てる教育","feature_description":"静岡聖光学院は、体験学習や探究活動を通じて自己理解を深め、興味・関心を学問、大学、仕事へつなげるキャリアプランニングを掲げています。学校独自の「思考コード」を教育目標の羅針盤に置き、知識を使って考える力や、自律して問題解決に取り組む姿勢を育てます。「思考コード」では、地域や国の視点から問題を解決する考え方も示されています。自己理解を出発点に将来の進路を考える学びを進めます。","clubs":[{"id":11997,"name":"中学・高校テニス部","category":"運動部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":11998,"name":"中学・高校バスケットボール部","category":"運動部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":11999,"name":"剣道部","category":"運動部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":12000,"name":"中学・高校サッカー部","category":"運動部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":12001,"name":"中学・高校ラグビー部","category":"運動部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":12002,"name":"美術部","category":"文化部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":12003,"name":"人文科学部","category":"文化部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":12004,"name":"自然科学部","category":"文化部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"},{"id":14482,"name":"吹奏楽部","category":"文化部","source_url":"https://www.s-seiko.ed.jp/school-life/club/","verified_at":"2026-11-16"}],"profile_sources":[{"id":2202,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=551","source_kind":"nichinoken","external_school_code":"551","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2203,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=551","s