{"id":557,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数と読む・書く習慣で基礎を固める教育","feature_description":"芦屋学園中学校は、読む・書くことを学びのベースに置き、国語・数学・英語・英会話を習熟度別の少人数クラスで学びます。読書タイム、宿題やノートへの丁寧な指導、必要に応じた補習を通じて基礎学力と学習習慣の定着を図ります。ネイティブ教員との交流や英会話、英検対策に加え、華道・茶道も学びます。宿泊行事では仲間づくり、歴史と日本文化、地域交流をテーマに、体験と発表を重ねます。","clubs":[{"id":10585,"name":"陸上競技部","category":"運動部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10586,"name":"バドミントン部","category":"運動部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10587,"name":"ダンス部","category":"運動部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10588,"name":"レスリング部","category":"運動部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10589,"name":"ESS部","category":"文化部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10590,"name":"吹奏楽部","category":"文化部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"},{"id":10591,"name":"理科部","category":"文化部","source_url":"https://www.ashiya.ed.jp/club/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1906,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=772","source_kind":"nichinoken","external_school_code":"772","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1907,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=772","source_kind":"nichinoken","external_school_code":"772","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1908,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=772","source_kind":"nichinoken","external_school_code":"772","verified_at":"2026-08