{"id":679,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際バカロレアを軸に世界で学ぶ学校","feature_description":"国際バカロレアの教育を軸に、国内外の多様な進路を見据えて学ぶ中高一貫校です。英語を活用する授業と探究的な学習を組み合わせ、国際社会の課題に向き合う視点を育てます。生徒が自ら問いを立て、他者と対話しながら考えを深める学びを大切にし、世界で主体的に行動できる力と高い英語運用力を目指します。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12647,"name":"女子サッカー部","category":"運動部","source_url":"https://aicj.ed.jp/cont/wp-content/themes/aicj/img/top/2024AICJbrochure.pdf","verified_at":"2026-08-11"}],"profile_sources":[{"id":2331,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=799","source_kind":"nichinoken","external_school_code":"799","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2332,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=799","source_kind":"nichinoken","external_school_code":"799","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2333,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=799","source_kind":"nichinoken","external_school_code":"799","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2334,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=799","source_kind":"nichinoken","external_school_code":"799","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2335,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=799","source_kind":"nichinoken","external_school_code":"799","verified_at":"2026-08-05","source_excerpt":null,