{"id":664,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"4つの合言葉で医歯薬に強く育てる","feature_description":"中高一貫教育と少人数の教科別指導を土台に、4つの合い言葉を軸とした日常の学びを重ねる学校です。歴史と伝統に加え、医歯薬に強い進路支援やチャレンジテスト、公開授業などを通して、基礎学力と進路意識を着実に高めます。学習面と生活面の両方から、生徒の伸びを細かく支えます。面倒見のよさと挑戦機会の多さが両立しています。進路相談も手厚く、安心して学べます。","clubs":[{"id":12465,"name":"吹奏楽部","category":"文化部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12466,"name":"インターアクト部","category":"同好会・愛好会","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12467,"name":"ロボット部","category":"文化部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12468,"name":"柔道部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12469,"name":"水泳部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12470,"name":"新体操部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12471,"name":"男子バスケットボール部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12472,"name":"女子バスケットボール部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12473,"name":"硬式テニス部","category":"運動部","source_url":"https://www.hosho.ed.jp/jhs/wp-content/uploads/2026/05/46b284763f98a6647bf2d6184258ea0c.pdf","verified_at":"2026-08-10"},{"id":12474,"name":"卓球部","category":"運動部","source_url":"http