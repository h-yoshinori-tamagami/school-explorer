{"id":9,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"世界市民を目指すPBL型のカトリック教育","feature_description":"サレジアン国際学園中学校高等学校は、カトリックの教育理念を基盤に、21世紀に活躍できる世界市民の育成を目指しています。全教科でPBL型授業を取り入れ、考え続ける力、言語活用力、心の教育、数理・科学リテラシー、コミュニケーション力を重点的に育てます。多様性を尊重し、他者と協働して課題を解決する力を養う学校です。公式情報をもとにまとめています。","clubs":[],"profile_sources":[{"id":43,"attribute_key":"religious_background","source_url":"https://www.salesian.international.seibi.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":44,"attribute_key":"uniform_policy","source_url":"https://www.salesian.international.seibi.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":45,"attribute_key":"high_school_progression","source_url":"https://www.salesian.international.seibi.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":46,"attribute_key":"international_programs","source_url":"https://www.salesian.international.seibi.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":47,"attribute_key":"learning_support","source_url":"https://www.salesian.international.seibi.ac.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-04-14","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2364,"attribute_key":"feature_summary","source_url":"https://www.salesian.international.seibi.ac.jp/contents/wp-content/uploads/2024/06/041da43136a52205460590ca4e8d9023-1.pdf","source_kind