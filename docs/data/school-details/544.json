{"id":544,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"英語と社会連携で広がる一人ひとりの学び","feature_description":"聖和学院は、生徒それぞれの特性に応じて社会とつながる学びを目指す中高一貫校です。神奈川県で唯一、高校に英語科を設置し、語学研修などを通じて英語教育の担い手を育てています。中学生と高校生が合同で取り組む部活動では、学年やクラスを越えた活動を経験できます。キャリア教育では「22歳の夢」を掲げ、進路指導と連動させながら将来像を考える機会を設けています。データサイエンス、探究、電子図書館も教育内容として案内されています。","clubs":[{"id":10491,"name":"バレーボール部","category":"運動部","source_url":"https://www.seiwagakuin.ed.jp/life/club/","verified_at":"2026-08-08"},{"id":10492,"name":"Girls’HipHop Club","category":"運動部","source_url":"https://www.seiwagakuin.ed.jp/life/club/","verified_at":"2026-08-08"},{"id":10493,"name":"新体操部","category":"運動部","source_url":"https://www.seiwagakuin.ed.jp/life/club/","verified_at":"2026-08-08"},{"id":10494,"name":"ESS","category":"文化部","source_url":"https://www.seiwagakuin.ed.jp/life/club/","verified_at":"2026-08-08"},{"id":10495,"name":"華道部","category":"文化部","source_url":"https://www.seiwagakuin.ed.jp/life/club/","verified_at":"2026-08-08"}],"profile_sources":[{"id":1862,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=352","source_kind":"nichinoken","external_school_code":"352","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1863,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=352","source_kind":"nichinoken","external_school_code":"352","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1864,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=352","source_kind":"nichinoken","external_school_code":"352","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3410,"attribute_key":"fe