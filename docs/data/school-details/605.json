{"id":605,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"毎朝の20分テストと丁寧な個別指導","feature_description":"金蘭千里は中高一貫の学びの中で、毎朝1教科20分のテストを行い、約2週間分の授業内容を振り返ります。国語・数学・英語に時間をかけて段階的に学習を進め、中学2年で中学校範囲、高校2年で高校範囲を修了する計画です。1学級約30人の少人数制を生かし、学習記録や個別指導、ICT活用を通じて一人ひとりの課題把握と学びの改善を支えます。","clubs":[{"id":11461,"name":"男子サッカー部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11462,"name":"バレーボール部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11463,"name":"硬式テニス部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11464,"name":"女子ダンス部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11465,"name":"バスケットボール部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11466,"name":"剣道部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11467,"name":"卓球部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11468,"name":"陸上部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11469,"name":"バドミントン部","category":"運動部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11470,"name":"合唱部","category":"文化部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11471,"name":"美術部","category":"文化部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11472,"name":"写真部","category":"文化部","source_url":"https://kinransenri.ed.jp/life/club/index.html","verified_at":"2026-11-16"},{"id":11473,"name":"科学部","category":"文化部","source_url":"https://kinransenri.ed.jp/life