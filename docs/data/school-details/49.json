{"id":49,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"サイエンスと探究で地域から世界へ学ぶ","feature_description":"京都府立南陽高等学校附属中学校は、高等学校と連携した中高一貫教育の中で、理数や探究を重視する学校です。地域や社会と関わる学習を通して、課題を見つけて考え、表現する力を育てます。幅広い教科の学びと体験活動を組み合わせ、将来の進路や社会への貢献を見据えて主体的に学ぶ姿勢を養います。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":2430,"attribute_key":"feature_summary","source_url":"https://www.kyoto-be.ne.jp/nannyou-hs/mt/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2431,"attribute_key":"feature_description","source_url":"https://www.kyoto-be.ne.jp/nannyou-hs/mt/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
