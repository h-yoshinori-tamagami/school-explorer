{"id":409,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"進学重視型で挑戦を支える水戸英宏","feature_description":"水戸英宏中学校は、「知の創造者たれ」を理念に、ひとりひとりの創造力と個性を大切にしながら、進学重視型教育で学力と進路実現を支える学校です。朝自習やスタディールーム、ICT環境が整い、部活動・同好会ではサッカー、科学、eスポーツなど多様な挑戦ができます。日々の学びを積み上げやすい点も魅力です。学習習慣を整えやすい点も心強いです。","clubs":[{"id":7775,"name":"サッカー部","category":"運動部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7776,"name":"女子ソフトテニス部","category":"運動部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7777,"name":"総合文化部","category":"文化部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7778,"name":"科学部","category":"文化部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7779,"name":"eスポーツ部","category":"文化部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7780,"name":"軽音部","category":"文化部","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7781,"name":"将棋・オセロ同好会","category":"同好会・愛好会","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7782,"name":"ダンス部","category":"その他","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7783,"name":"軽音楽部","category":"その他","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7784,"name":"書道部","category":"その他","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"},{"id":7785,"name":"ブラスバンド部","category":"その他","source_url":"https://www.mito-eiko.ed.jp/contents/club/","verified_at":"2026-08-07"}],"profile_sources":[{"id":1412,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=429","source_kind":"nichinoken","external_school_code":"429","verified_at":"2026-08-05","source_excerpt":null,"fetched