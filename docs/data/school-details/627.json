{"id":627,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"平和と人間主義を基盤にした教育","feature_description":"平和と人間主義を基盤にした教育を教育の中心に据え、教科の学びと学校生活を結び付けながら、生徒が自ら考え行動する力を育てます。基礎となる知識や技能を着実に身に付けるとともに、探究、対話、行事、部活動などの経験を通して、多様な仲間と協働し課題に向き合います。一人ひとりが自分の目標を見つけ、学びを深め、社会や世界に関わる視野を広げられるよう支える教育です。","clubs":[],"profile_sources":[{"id":2140,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=740","source_kind":"nichinoken","external_school_code":"740","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2141,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=740","source_kind":"nichinoken","external_school_code":"740","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2142,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=740","source_kind":"nichinoken","external_school_code":"740","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2143,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=740","source_kind":"nichinoken","external_school_code":"740","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3576,"attribute_key":"feature_summary","source_url":"https://kansai-junior.soka.ed.jp/study/educationalgoal/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3577,"attribute_key":"feature_description","source_url":"https://kansai-junior.soka.ed.jp/study/educat