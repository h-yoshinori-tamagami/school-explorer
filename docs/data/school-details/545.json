{"id":545,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"カトリック精神と探究で磨く女子教育","feature_description":"聖園女学院は、カトリックの教育モットー「人間の尊厳のために」を大切にし、確かな学力と人としての生き方を学ぶ女子教育を進める学校です。カリキュラム、総合学習・総合探究、国際教育、学習支援を通して一人ひとりの成長を支えます。学院生活では文化部・運動部に加え、聖歌隊やハンドベルクワイアも活動しています。学年を越えた仲間と夢や目標に向かう経験を通じて、挑戦する心と自分の可能性を広げることを目指します。","clubs":[{"id":10496,"name":"演劇部","category":"文化部","source_url":"https://www.misono.jp/school/club.html","verified_at":"2026-08-08"},{"id":10497,"name":"科学部","category":"文化部","source_url":"https://www.misono.jp/school/club.html","verified_at":"2026-08-08"},{"id":10498,"name":"弓道部","category":"運動部","source_url":"https://www.misono.jp/school/club.html","verified_at":"2026-08-08"},{"id":10499,"name":"硬式テニス部","category":"運動部","source_url":"https://www.misono.jp/school/club.html","verified_at":"2026-08-08"},{"id":10500,"name":"聖歌隊","category":"その他","source_url":"https://www.misono.jp/school/club.html","verified_at":"2026-08-08"}],"profile_sources":[{"id":1865,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=357","source_kind":"nichinoken","external_school_code":"357","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1866,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=357","source_kind":"nichinoken","external_school_code":"357","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1867,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=357","source_kind":"nichinoken","external_school_code":"357","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1868,"attribute_key":"high_school_progression","source_url":"https://