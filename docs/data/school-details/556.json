{"id":556,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自立学習とSTEAM探究を結ぶ理工系一貫教育","feature_description":"芝浦工業大学附属中学校は、授業・自立学習SD・SHIBAURA探究を連携させた中高一貫教育を行います。SDでは学習内容を振り返り、アウトプットしながら定着を図ります。IT、GC、総合探究では、デザイン思考やグローバルな視点を取り入れたチーム協働型のプロジェクト学習を実施します。芝浦工業大学との連携によるSTEAM教育や三つの言語教育も通じ、理工系の知識で社会課題の解決を目指す力を育てます。","clubs":[{"id":10578,"name":"卓球部","category":"運動部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10579,"name":"中学バスケットボール部","category":"運動部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10580,"name":"中学サッカー部","category":"運動部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10581,"name":"中学硬式テニス部","category":"運動部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10582,"name":"理科部","category":"文化部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10583,"name":"電子技術研究部","category":"文化部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"},{"id":10584,"name":"工作技術研究部","category":"文化部","source_url":"https://www.fzk.shibaura-it.ac.jp/school-life/club/","verified_at":"2026-08-10"}],"profile_sources":[{"id":1900,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=238","source_kind":"nichinoken","external_school_code":"238","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1901,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=238","source_kind":"nichinoken","external_school_code":"238","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1902,"attribute_ke