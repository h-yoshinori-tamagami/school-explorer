{"id":428,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"正・浄・和と個人を尊重する人間教育","feature_description":"浦和明の星女子中学校はカトリックのミッションスクールで、校訓「正・浄・和」を教育の柱としています。学校公式の説明では、「正」は本当の自分として生きること、「浄」はありのままを受け入れて自由に生きること、「和」は互いに助け合うことを表します。他者をかけがえのない存在として尊重する人間教育を掲げ、中高6年間の生活の中でこの価値観を深めます。","clubs":[{"id":15321,"name":"サッカー部","category":"運動部","source_url":"https://www.urawa-akenohoshi.ed.jp/seikatu/committee_club/","verified_at":"2026-11-20"}],"profile_sources":[{"id":1476,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=466","source_kind":"nichinoken","external_school_code":"466","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1477,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=466","source_kind":"nichinoken","external_school_code":"466","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1478,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=466","source_kind":"nichinoken","external_school_code":"466","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":"2026-11-15T20:58:33.597531","priority":null},{"id":1479,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=466","source_kind":"nichinoken","external_school_code":"466","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3162,"attribute_key":"feature_summary","source_url":"https://www.urawa-akenohoshi.ed.jp/school/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-11-16","source_excerpt":null,"fetched_at":null,"content_hash":n