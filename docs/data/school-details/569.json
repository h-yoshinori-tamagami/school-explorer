{"id":569,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"授業第一主義と主体性で社会に役立つ人を育成","feature_description":"土浦第一高等学校附属中学校は、校訓「自主・協同・責任」と教育理念を基盤に、高い知性と豊かな人間性を備え、社会に役立つ人材を育てます。授業第一主義のもと、知識伝達と知識探究を組み合わせたアクティブ・ラーニング型授業、学年指導、個別指導を実践します。文理を問わず幅広い教養を学び、学習・行事・部活動に主体的かつ能動的に取り組む「一高スタイル」を大切にしています。","clubs":[{"id":10724,"name":"吹奏楽部","category":"文化部","source_url":"https://www.tsuchiura1-h.ibk.ed.jp/51f96232d6a96f7b9b75b5d5d2b6175a/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95/%E5%90%B9%E5%A5%8F%E6%A5%BD","verified_at":"2026-08-10"}],"profile_sources":[{"id":3460,"attribute_key":"feature_summary","source_url":"https://www.tsuchiura1-h.ibk.ed.jp/%E6%95%99%E8%82%B2%E3%81%AE%E7%89%B9%E8%89%B2","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3461,"attribute_key":"feature_description","source_url":"https://www.tsuchiura1-h.ibk.ed.jp/%E6%95%99%E8%82%B2%E3%81%AE%E7%89%B9%E8%89%B2","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
