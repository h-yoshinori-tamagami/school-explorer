{"id":534,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"三つの力を磨く細田学園の未来教育","feature_description":"細田学園は、最先端の教育環境と授業による学力、思考・判断・実行を支える自己実現力、社会を切り拓く人間力を三つの軸に掲げます。部活動、未来科、語学研修、キャリア教育などを通じて、自ら課題を発見し価値を創造する姿勢を育てます。学習では計画・実行・評価・改善を重ねる独自のAPDCサイクル、習熟度別授業、個別指導を組み合わせています。学びと学校生活を往復しながら主体性を伸ばす教育です。","clubs":[],"profile_sources":[{"id":1817,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=495","source_kind":"nichinoken","external_school_code":"495","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1818,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=495","source_kind":"nichinoken","external_school_code":"495","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1819,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=495","source_kind":"nichinoken","external_school_code":"495","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1820,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=495","source_kind":"nichinoken","external_school_code":"495","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1821,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=495","source_kind":"nichinoken","external_school_code":"495","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3390,"attribute_key":"feature_summary","source_url":"https://www.ho