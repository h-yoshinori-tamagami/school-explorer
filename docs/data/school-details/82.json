{"id":82,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究と理数で未来を拓く県立中高一貫","feature_description":"兵庫県立大学附属中学校・高等学校は、県立大学とのつながりを持つ中高一貫校として、探究的な学びと理数的な思考を重視しています。6年間を見通した教育活動の中で、基礎学力、課題発見力、表現力を育てます。大学や地域との関わりも生かし、将来の進路を主体的に考える力を養います。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":1435,"name":"陸上部","category":"運動部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1436,"name":"剣道部","category":"運動部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1437,"name":"女子バスケットボール部","category":"運動部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1438,"name":"男子バスケットボール部","category":"運動部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1439,"name":"卓球部","category":"運動部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1440,"name":"自然科学部","category":"文化部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1441,"name":"茶道部","category":"文化部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1442,"name":"ESS部","category":"文化部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"},{"id":1443,"name":"美術部","category":"文化部","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2496,"attribute_key":"feature_summary","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2497,"attribute_key":"feature_description","source_url":"https://dmzcms.hyogo-c.ed.jp/kendai-hs/NC3/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt"