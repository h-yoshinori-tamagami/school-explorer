{"id":671,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"中高一貫で文武両道を育む教育の特色","feature_description":"中高一貫教育のもと、知・徳・体の調和を大切にした学びを行う学校です。少人数での学習支援と進路指導を通じて、一人ひとりの目標に向き合います。部活動では高校生とともに活動できる環境も整え、短い時間に集中して取り組む文武両道を教育目標の一つとして掲げています。行事や日々の学校生活も通して、仲間と協働する力を育てます。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12607,"name":"野球部","category":"運動部","source_url":"https://j-kd.tsuzuki-edu.ac.jp/bukatsu/","verified_at":"2026-08-11"},{"id":12608,"name":"男子硬式テニス部","category":"運動部","source_url":"https://j-kd.tsuzuki-edu.ac.jp/bukatsu/","verified_at":"2026-08-11"},{"id":12609,"name":"女子硬式テニス部","category":"運動部","source_url":"https://j-kd.tsuzuki-edu.ac.jp/bukatsu/","verified_at":"2026-08-11"},{"id":12610,"name":"サッカー部","category":"運動部","source_url":"https://j-kd.tsuzuki-edu.ac.jp/bukatsu/","verified_at":"2026-08-11"},{"id":12611,"name":"吹奏楽部","category":"文化部","source_url":"https://j-kd.tsuzuki-edu.ac.jp/bukatsu/","verified_at":"2026-08-11"}],"profile_sources":[{"id":2296,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=891","source_kind":"nichinoken","external_school_code":"891","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2297,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=891","source_kind":"nichinoken","external_school_code":"891","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2298,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=891","source_kind":"nichinoken","external_school_code":"891","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2299,"attribute_key":"high_school_progression","source_url