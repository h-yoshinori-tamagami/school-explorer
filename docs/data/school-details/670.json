{"id":670,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"宇宙学と探究で寮生活から成長する","feature_description":"宇宙学、ことば探究、肝付学などのカテゴリを軸に、寮生活や学校行事、部活動を通して学びを深める中高一貫校です。共学化後の学校生活を発信する公式ブログとして、行事や学習の積み重ねを日々伝え、主体性と挑戦する姿勢を育てています。学校全体をブログで継続発信している点も特徴的です。学習と生活を同時に追えるのが独自です。多面的な記録が日常的に更新されます。","clubs":[{"id":12605,"name":"高校宇宙部","category":"その他","source_url":"https://nansyun.edu.pref.kagoshima.jp/category/category/bukatu/","verified_at":"2026-08-10"},{"id":12606,"name":"水泳部","category":"運動部","source_url":"https://nansyun.edu.pref.kagoshima.jp/article/2026072100217/","verified_at":"2026-08-10"}],"profile_sources":[{"id":3662,"attribute_key":"feature_summary","source_url":"https://nansyun.edu.pref.kagoshima.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3663,"attribute_key":"feature_description","source_url":"https://nansyun.edu.pref.kagoshima.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-10","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
