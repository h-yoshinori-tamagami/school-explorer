{"id":287,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"良心の人物を育てる新島学園中高","feature_description":"キリスト教精神を教育の基盤とし、新島襄の理念である「良心の充満した人物」の育成をめざしています。教育理念、スクール・ポリシー、キリスト教教育、学校生活、生徒活動、部活動が整理され、日常と学びの関係を追いやすい学校です。進学情報や制服、年間行事も並び、全体像が見えやすい構成です。学校紹介、学校生活、行事、進路、部活動の導線がそろっており、入学後の姿を想像しやすい学校です。","clubs":[],"profile_sources":[{"id":2806,"attribute_key":"feature_summary","source_url":"https://niijima-gakuen.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2807,"attribute_key":"feature_description","source_url":"https://niijima-gakuen.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
