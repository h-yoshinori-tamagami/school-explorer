{"id":197,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"文武技芸で育つ宮崎日大中高一貫","feature_description":"宮崎第一中学校は、中高一貫の流れや各教科の取り組み、学校説明会、動画コンテンツを通じて、学習と生活の両面を丁寧に案内する学校です。公式サイトでは「授業がすべて」を軸にした学習指導と、部活動体験会など、日々の学びを積み上げる校風が伝わります。 学校説明会や各教科の取り組みも充実しており、学習と生活の両立を支える案内が分かりやすいです。","clubs":[],"profile_sources":[{"id":791,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=879","source_kind":"nichinoken","external_school_code":"879","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":792,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=879","source_kind":"nichinoken","external_school_code":"879","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":793,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=879","source_kind":"nichinoken","external_school_code":"879","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":794,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=879","source_kind":"nichinoken","external_school_code":"879","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":795,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=879","source_kind":"nichinoken","external_school_code":"879","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":796,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/