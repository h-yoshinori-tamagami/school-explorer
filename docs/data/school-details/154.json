{"id":154,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"ICTと人間教育を進める大谷中高","feature_description":"大谷中学・高等学校は、教育理念に基づく人間教育と、NEXT GIGAを見据えたICT活用を両立させる学校です。公式サイトやパンフレットでは、学びを支える環境整備と、広い視野や思いやりを育てる方針が確認でき、比較用の学校像をつかみやすい構成でした。1人1台端末や高速通信環境も整っています。クラブ活動の案内もあり、学びと課外活動を見通しやすいです。","clubs":[{"id":3535,"name":"テニス部","category":"運動部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3536,"name":"競技スキー部","category":"運動部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3537,"name":"水球部","category":"運動部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3538,"name":"写真部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3539,"name":"美術部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3540,"name":"模型部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3541,"name":"GAC (数学) 部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3542,"name":"コーラス部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"},{"id":3543,"name":"ハレジャ部","category":"文化部","source_url":"https://www.otani.ed.jp/2025_clubguide_junior.pdf","verified_at":"2026-08-06"}],"profile_sources":[{"id":2720,"attribute_key":"feature_summary","source_url":"https://www.otani.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2721,"attribute_key":"feature_description","source_url":"https://www.otani.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","