{"id":95,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"国際性と探究で自分らしく学ぶ教育","feature_description":"千代田国際中学校は、国際的な視野と主体的な学びを重視する学校です。英語、探究、ICT、行事を通して、自分の考えを持ち、他者と協働しながら課題に向き合う力を育てます。多様な価値観に触れる学校生活の中で、将来の進路や社会との関わりを自分らしく考える姿勢を養います。公式サイトの紹介内容をもとに、教育方針や学校生活を整理してまとめています。","clubs":[{"id":1610,"name":"男子バスケットボール","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1611,"name":"女子バスケットボール","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1612,"name":"バドミントン（中学生のみ）","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1613,"name":"卓球","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1614,"name":"ダンス","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1615,"name":"フットサル","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1616,"name":"バトン","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1617,"name":"空手","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"},{"id":1618,"name":"ソフトテニス（高校のみ）","category":"運動部","source_url":"https://chiyoda.ed.jp/life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2522,"attribute_key":"feature_summary","source_url":"https://chiyoda.ed.jp/chiyoda_inter/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2523,"attribute_key":"feature_description","source_url":"https://chiyoda.ed.jp/chiyoda_inter/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
