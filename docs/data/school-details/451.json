{"id":451,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"文武両道で個性を伸ばす照曜館の学び","feature_description":"照曜館中学校は、東筑紫学園の建学の精神「筑紫の心」を土台に、個人の力を伸ばす6か年一貫教育を行っています。少人数でのきめ細かな指導に加え、行事や部活動を通して協調性と主体性を育て、文武両道を後押しします。高校生と一緒に活動する機会もあり、先輩の姿から学べる学校生活が特徴です。日々の積み重ねで進路につなげます。多様な部で役割を持てます。","clubs":[{"id":8931,"name":"卓球部","category":"運動部","source_url":"https://shoyou.hcg.ed.jp/admissions/club/","verified_at":"2026-08-07"},{"id":8932,"name":"サッカー部","category":"運動部","source_url":"https://shoyou.hcg.ed.jp/admissions/club/","verified_at":"2026-08-07"},{"id":8933,"name":"バトン部","category":"その他","source_url":"https://shoyou.hcg.ed.jp/admissions/club/","verified_at":"2026-08-07"},{"id":8934,"name":"バスケットボール部","category":"運動部","source_url":"https://shoyou.hcg.ed.jp/admissions/club/","verified_at":"2026-08-07"}],"profile_sources":[{"id":1571,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=823","source_kind":"nichinoken","external_school_code":"823","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1572,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=823","source_kind":"nichinoken","external_school_code":"823","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1573,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=823","source_kind":"nichinoken","external_school_code":"823","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1574,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=823","source_kind":"nichinoken","external_school_code":"823","verified_at":"2026-08-05","sou