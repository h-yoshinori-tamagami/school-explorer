{"id":468,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"一人ひとりに合わせた甲子園学院","feature_description":"甲子園学院中学校・高等学校は、少人数での習熟度別・選択授業を通して、一人ひとりに合わせた学びを実現する学校です。建学の精神のもとで人間性を育み、6年間の中で個性と学力の両方を伸ばします。オープンスクールでも部活動見学を行っており、学校生活の中で活動を体験しやすい点も特徴です。自分のペースで力を積み上げやすいです。放課後の活動も含めて成長できます。","clubs":[{"id":9267,"name":"剣道部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9268,"name":"バレーボール部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9269,"name":"ソフトテニス部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9270,"name":"バスケットボール部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9271,"name":"ダンス部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9272,"name":"撞球（ビリヤード）部","category":"その他","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"},{"id":9273,"name":"水泳部","category":"運動部","source_url":"https://www.koshiengakuin-h.ed.jp/campus_life/club.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":1604,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=781","source_kind":"nichinoken","external_school_code":"781","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1605,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=781","source_kind":"nichinoken","external_school_code":"781","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1606,"attribute_key":"affiliation_type"