{"id":46,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"バタビア教育で個性と進路を伸ばす","feature_description":"京都共栄学園中学校・高等学校は、バタビアコースを中心に、一人ひとりの個性と学力を伸ばす中高一貫教育を行っています。基礎学力を丁寧に積み上げ、英語、探究、行事、部活動を通じて主体性と協働性を育てます。進路実現に向けたきめ細かな指導と、温かな学校生活を大切にしている学校です。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[{"id":15103,"name":"軟式野球部","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15104,"name":"バスケットボール部(男子)","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15105,"name":"バスケットボール部(女子)","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15106,"name":"陸上部(男女)","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15107,"name":"硬式テニス部","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15108,"name":"水泳部","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15109,"name":"柔道部","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15110,"name":"剣道部","category":"運動部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15111,"name":"吹奏楽部","category":"文化部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15112,"name":"理科部","category":"文化部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15113,"name":"美術部","category":"文化部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"},{"id":15114,"name":"将棋部","category":"文化部","source_url":"https://www.kyoei.ed.jp/clubjhs/","verified_at":"2026-11-20"}],"profile_sources":[{"id":351,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=634","source_kind":"nichinoken","external_school_code":"634","verified_at":"2026-08-05","source_excerpt":null,"f