{"id":46,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"バタビア教育で個性と進路を伸ばす","feature_description":"京都共栄学園中学校・高等学校は、バタビアコースを中心に、一人ひとりの個性と学力を伸ばす中高一貫教育を行っています。基礎学力を丁寧に積み上げ、英語、探究、行事、部活動を通じて主体性と協働性を育てます。進路実現に向けたきめ細かな指導と、温かな学校生活を大切にしている学校です。公式サイトの紹介内容をもとに整理してまとめています。","clubs":[],"profile_sources":[{"id":351,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=634","source_kind":"nichinoken","external_school_code":"634","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":352,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=634","source_kind":"nichinoken","external_school_code":"634","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":353,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=634","source_kind":"nichinoken","external_school_code":"634","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2424,"attribute_key":"feature_summary","source_url":"https://www.kyoto-kyoei.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2425,"attribute_key":"feature_description","source_url":"https://www.kyoto-kyoei.ed.jp/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
