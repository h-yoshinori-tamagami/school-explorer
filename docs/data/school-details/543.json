{"id":543,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"自律と体験を重ねる男子校の学び","feature_description":"聖光学院は、建学の精神を土台に、授業だけでなく聖光塾、高校一年の土曜講座、中学二年の選択芸術などを教育の特色として掲げる男子校です。学校生活では運動部・文化部に加え、生徒が自主的につくる公認団体の活動も紹介しています。多様な生徒活動に主体的に関わり、仲間とともに興味を深められる環境です。部活動では競技、科学、音楽、研究分野など選択肢が幅広く、学校生活の中で自分の関心を育てる機会があります。","clubs":[{"id":10486,"name":"野球部","category":"運動部","source_url":"https://www.seiko.ac.jp/seikatsu/student","verified_at":"2026-08-08"},{"id":10487,"name":"サッカー部","category":"運動部","source_url":"https://www.seiko.ac.jp/seikatsu/student","verified_at":"2026-08-08"},{"id":10488,"name":"水泳部","category":"運動部","source_url":"https://www.seiko.ac.jp/seikatsu/student","verified_at":"2026-08-08"},{"id":10489,"name":"物理科学部","category":"文化部","source_url":"https://www.seiko.ac.jp/seikatsu/student","verified_at":"2026-08-08"},{"id":10490,"name":"弦楽オーケストラ部","category":"文化部","source_url":"https://www.seiko.ac.jp/seikatsu/student","verified_at":"2026-08-08"}],"profile_sources":[{"id":1858,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=326","source_kind":"nichinoken","external_school_code":"326","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1859,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=326","source_kind":"nichinoken","external_school_code":"326","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1860,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=326","source_kind":"nichinoken","external_school_code":"326","verified_at":"2026-08-04","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1861,"attribute_key":"international_programs","source_url":"ht