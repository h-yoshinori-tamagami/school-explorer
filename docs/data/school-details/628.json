{"id":628,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"考える科と体験で考動力を育てる教育","feature_description":"考える科と体験で考動力を育てる教育を教育の中心に据え、教科の学びと学校生活を結び付けながら、生徒が自ら考え行動する力を育てます。基礎となる知識や技能を着実に身に付けるとともに、探究、対話、行事、部活動などの経験を通して、多様な仲間と協働し課題に向き合います。一人ひとりが自分の目標を見つけ、学びを深め、社会や世界に関わる視野を広げられるよう支える教育です。","clubs":[],"profile_sources":[{"id":2144,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=696","source_kind":"nichinoken","external_school_code":"696","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2145,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=696","source_kind":"nichinoken","external_school_code":"696","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2146,"attribute_key":"affiliation_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=696","source_kind":"nichinoken","external_school_code":"696","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2147,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=696","source_kind":"nichinoken","external_school_code":"696","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2148,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=696","source_kind":"nichinoken","external_school_code":"696","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2149,"attribute_key":"learning_support","source_url":"https://www.nichinoken.co.jp