{"id":565,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"地域探究と科学・国際教育を進める六年一貫校","feature_description":"下館第一高等学校附属中学校は、自主自立の精神を持ち、地域のリーダーや国際社会で活躍する人を育てることを目標にします。地域の中で学ぶ六年間の教育を柱に、探究活動、国際教育、科学教育を展開しています。五十五分授業や国語・数学・理科・英語の時間増、習熟度別学習、ICT活用で確かな学力を育成します。複数担任制や異年齢交流も取り入れ、協働して課題を解決する力を伸ばします。","clubs":[{"id":10662,"name":"陸上競技部","category":"運動部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10663,"name":"剣道部","category":"運動部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10664,"name":"卓球部","category":"運動部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10665,"name":"バレーボール部","category":"運動部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10666,"name":"吹奏楽部","category":"文化部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10667,"name":"英語部","category":"文化部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10668,"name":"理科部","category":"文化部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5%AD%A6%E6%A0%A1%E7%94%9F%E6%B4%BB/%E9%83%A8%E6%B4%BB%E5%8B%95","verified_at":"2026-08-07"},{"id":10669,"name":"クリエイト部","category":"文化部","source_url":"https://www.shimodate1-jh.ibk.ed.jp/4c5bd7e86929beb960ab32b00f519677/%E5