{"id":513,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"全員参加の部活動で学ぶ福島成蹊","feature_description":"福島成蹊中学校は、中高一貫の学びに加えて、全員参加の部活動で協調性と挑戦する姿勢を育てています。中学部活動は総合運動部、卓球部、茶道部、文化表現部の4つで、学業と活動を両立しながら追究できる構成です。学校生活と行事も公式ページで確認できます。日々の積み重ねで自分の役割を見つけ、学習と活動を両立しやすい環境です。学校生活の見通しも立てやすいです。","clubs":[{"id":10081,"name":"総合運動部","category":"運動部","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","verified_at":"2026-08-07"},{"id":10082,"name":"卓球部","category":"運動部","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","verified_at":"2026-08-07"},{"id":10083,"name":"茶道部","category":"文化部","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","verified_at":"2026-08-07"},{"id":10084,"name":"文化表現部","category":"文化部","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","verified_at":"2026-08-07"}],"profile_sources":[{"id":3348,"attribute_key":"feature_summary","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3349,"attribute_key":"feature_description","source_url":"https://www.f-seikei.ed.jp/jhs/club.php","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
