{"id":306,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"少人数一貫で基礎から進路へ導く昇陽","feature_description":"昇陽中学校は、少人数でアットホームな環境の中、6か年一貫で学びを進める学校です。3段階で基礎力を固め、実力を伸ばし、最後に進路へつなげる構成が示されており、学習の流れがつかみやすいです。学校生活と教育方針の両面が整理されています。 公式サイトの学校生活や行事の導線も整っており、比較用に必要な情報を確認しやすいです。入学後の姿も想像しやすいです。","clubs":[{"id":5901,"name":"男子サッカー","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5902,"name":"男子柔道","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5903,"name":"男女バスケットボール","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5904,"name":"男女ソフトボール","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5905,"name":"高校女子ソフトテニス部","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5906,"name":"新体操","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5907,"name":"ダンス","category":"運動部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5908,"name":"吹奏楽","category":"文化部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5909,"name":"軽音楽","category":"文化部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"},{"id":5910,"name":"茶道","category":"文化部","source_url":"https://www.oskshoyo.ed.jp/jhs/examinee/contact/","verified_at":"2026-08-06"}],"profile_sources":[{"id":1083,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=698","source_kind":"nichinoken","external_school_code":"698","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},