{"id":572,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"地域・企業探究で主体性を育む一貫教育","feature_description":"水海道第一高附属は、生徒の「好き、得意、やりたい、なりたい」を起点に、主体的に未来を切り拓く力を育てます。地域・企業探究を軸に、1年は自己と地域、2年は地域の社会課題、3年は企業課題に向き合い、語学研修、職業体験、海外体験留学や企業インターンを組み合わせます。ICT活用と協働学習、地域人材・企業との連携を通じて、課題を発見し解決する資質と進路を考える力を培います。","clubs":[{"id":10740,"name":"ハンドボール部","category":"運動部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"},{"id":10741,"name":"卓球部","category":"運動部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"},{"id":10742,"name":"剣道部","category":"運動部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"},{"id":10743,"name":"吹奏楽部","category":"文化部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"},{"id":10744,"name":"自然科学部","category":"文化部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"},{"id":10745,"name":"英語研究部","category":"文化部","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1571","verified_at":"2026-08-10"}],"profile_sources":[{"id":3466,"attribute_key":"feature_summary","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1488","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3467,"attribute_key":"feature_description","source_url":"https://www.mitsukaido1-jh.ibk.ed.jp/wysiwyg/file/download/15/1488","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
