{"id":514,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"IBとMYPで挑む秀光中学の学び","feature_description":"秀光中学校は、IBのMYP奉仕活動やCAS、武道・日本文化、スポーツチャレンジを通じて、挑み続ける心を育てます。2021年開校の新しい中学校で、生徒会活動も全校参加型です。学びと活動を結び、協働しながら成長できる構成が公式サイトで整理されています。日々の積み重ねで自分の役割を見つけ、学習と活動を両立しやすい環境です。学校生活の見通しも立てやすいです。","clubs":[{"id":10085,"name":"ESS部","category":"文化部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"},{"id":10086,"name":"インターアクト部","category":"文化部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"},{"id":10087,"name":"オーケストラ部","category":"文化部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"},{"id":10088,"name":"合唱部","category":"文化部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"},{"id":10089,"name":"ロボティクス部","category":"文化部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"},{"id":10090,"name":"シーズンスポーツ部","category":"運動部","source_url":"https://www.sendaiikuei.ed.jp/shukoh/education/feature/sports.html","verified_at":"2026-08-07"}],"profile_sources":[{"id":1740,"attribute_key":"dormitory_available","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=525","source_kind":"nichinoken","external_school_code":"525","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1741,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=525","source_kind":"nichinoken","external_school_code":"525","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1742,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/in