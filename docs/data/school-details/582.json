{"id":582,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"主体的な探究と六年一貫で未来を拓く学び","feature_description":"西武台新座は、生徒一人ひとりを尊重し、六年一貫の学びを通して将来を切り拓く力を育てます。早い段階からの学習の積み上げに加え、教科探究やAIを活用して、実社会の課題に向き合う機会を設けています。情報を集め、自分の考えを表現する力を大切にし、挑戦を後押しする環境で学びます。学力と探究心を結び付け、主体的に進路を考える教育が特徴です。","clubs":[],"profile_sources":[{"id":1976,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=484","source_kind":"nichinoken","external_school_code":"484","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1977,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=484","source_kind":"nichinoken","external_school_code":"484","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1978,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=484","source_kind":"nichinoken","external_school_code":"484","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1979,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=484","source_kind":"nichinoken","external_school_code":"484","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1980,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=484","source_kind":"nichinoken","external_school_code":"484","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3486,"attribute_key":"feature_summary","source_url":"https://www.seibudai.ed.jp/junior/ph