{"id":546,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"探究とグローバル教育で未来を拓く学び","feature_description":"聖学院は、生徒主体の探究型教育を通して、自己発信力、問題解決力、コミュニケーション能力を磨く男子校です。授業では課題を議論・探究し、ポスターセッションやプレゼンテーションで表現する学びを重ねます。外部団体との共同学習も取り入れ、専門家の視点に触れる機会を用意しています。国語、数学、社会、理科、技術・情報など幅広い教科で実践し、グローバル教育やSTEAM教育、進路・キャリア教育とも結びつけて、社会に関わる力を育てます。","clubs":[{"id":10501,"name":"サッカー","category":"運動部","source_url":"https://www.seigakuin.ed.jp/intro/club/","verified_at":"2026-08-08"},{"id":10502,"name":"ワンダーフォーゲル","category":"運動部","source_url":"https://www.seigakuin.ed.jp/intro/club/","verified_at":"2026-08-08"},{"id":10503,"name":"ラグビー","category":"運動部","source_url":"https://www.seigakuin.ed.jp/intro/club/","verified_at":"2026-08-08"},{"id":10504,"name":"化学","category":"文化部","source_url":"https://www.seigakuin.ed.jp/intro/club/","verified_at":"2026-08-08"},{"id":10505,"name":"プログラミング","category":"文化部","source_url":"https://www.seigakuin.ed.jp/intro/club/","verified_at":"2026-08-08"}],"profile_sources":[{"id":3414,"attribute_key":"feature_summary","source_url":"https://www.seigakuin.ed.jp/quest_pbl/lesson/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3415,"attribute_key":"feature_description","source_url":"https://www.seigakuin.ed.jp/quest_pbl/lesson/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-08","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
