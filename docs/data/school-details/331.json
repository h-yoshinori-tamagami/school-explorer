{"id":331,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"キリスト教精神で人格完成をめざす","feature_description":"暁星学園は、キリスト教の理念に基づく教育によって人格の完成をめざし、社会の福祉に努める人物の育成を掲げています。学園として一貫した理念が明確で、知識だけでなく人間性や奉仕の姿勢も重視する点が特徴です。教育理念が簡潔に整理され、比較用に把握しやすいです。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[],"profile_sources":[{"id":1158,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=106","source_kind":"nichinoken","external_school_code":"106","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1159,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=106","source_kind":"nichinoken","external_school_code":"106","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1160,"attribute_key":"lunch_type","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=106","source_kind":"nichinoken","external_school_code":"106","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1161,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=106","source_kind":"nichinoken","external_school_code":"106","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2970,"attribute_key":"feature_summary","source_url":"https://www.gyosei.ed.jp/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2971,"attribute_key":"feature_description","source_url":"https://www.gyosei.ed.jp/about/","source_kind":"official_site","external_