{"id":307,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"夢探究と国際性で伸びる昌平中高","feature_description":"昌平中学校・高等学校は、夢を探究する力と国際性を備えた若者を育てることを大切にしています。主体的に学び、考え、表現できる力を伸ばす方針が明確で、学習と人格形成を両輪に据えた中高一貫教育を進めます。公式サイトでは、教育の柱が整理されており比較しやすい構成です。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5455,"name":"サッカー部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5456,"name":"硬式テニス部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5457,"name":"ラグビー部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5458,"name":"バスケットボール部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5459,"name":"バドミントン部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5460,"name":"剣道部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5461,"name":"陸上部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5462,"name":"ダンス部","category":"運動部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5463,"name":"吹奏楽部","category":"文化部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"},{"id":5464,"name":"ESS","category":"文化部","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/school_life/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2942,"attribute_key":"feature_summary","source_url":"https://www.shohei.sugito.saitama.jp/contents/jhs/education/policy/