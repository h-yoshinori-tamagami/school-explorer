{"id":539,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"心と力を育む聖セシリアの総合教育","feature_description":"聖セシリア女子は、カトリック精神に基づき、知育・徳育・体育の調和をめざす総合教育を行います。週五日三十二時間のカリキュラムで英語・数学・国語などの言語科目と読解力を重視し、論理力や表現力を育てます。芸術教育、福祉活動、宗教教育、構成的エンカウンターを通じて、豊かな感性と他者を理解する力を養います。自ら人生を切り開き、社会に貢献する人を目指す学校です。","clubs":[],"profile_sources":[{"id":1842,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=341","source_kind":"nichinoken","external_school_code":"341","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1843,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=341","source_kind":"nichinoken","external_school_code":"341","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1844,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=341","source_kind":"nichinoken","external_school_code":"341","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1845,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=341","source_kind":"nichinoken","external_school_code":"341","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3400,"attribute_key":"feature_summary","source_url":"https://www.cecilia.ac.jp/education/features/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3401,"attribute_key":"feature_description","source_url":"https://www.cecilia.ac.jp/education/featu