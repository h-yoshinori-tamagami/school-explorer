{"id":677,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"理数グローバルで育てる課題解決力","feature_description":"理数グローバルを柱とする中高一貫教育で、英語を学びながら論理的に考え、課題を自ら解決する力を育てます。iPadや各種EdTechを活用した学習と、理数・英語を横断する学びを組み合わせます。教育理念に基づき、地域や世界の課題にも目を向けながら、確かな学力と多様な人々と協働する姿勢を身につけることを目指します。学校が公式に掲げる教育内容と学校生活を通して、生徒一人ひとりの成長を支えます。","clubs":[{"id":12637,"name":"剣道部","category":"運動部","source_url":"https://www.sagaryukoku.ed.jp/jhsc/club/","verified_at":"2026-08-11"},{"id":12638,"name":"テニス部","category":"運動部","source_url":"https://www.sagaryukoku.ed.jp/jhsc/club/","verified_at":"2026-08-11"},{"id":12639,"name":"バドミントン部","category":"運動部","source_url":"https://www.sagaryukoku.ed.jp/jhsc/club/","verified_at":"2026-08-11"},{"id":12640,"name":"書道部","category":"文化部","source_url":"https://www.sagaryukoku.ed.jp/jhsc/club/","verified_at":"2026-08-11"},{"id":12641,"name":"サイエンス部","category":"文化部","source_url":"https://www.sagaryukoku.ed.jp/jhsc/club/","verified_at":"2026-08-11"}],"profile_sources":[{"id":3676,"attribute_key":"feature_summary","source_url":"https://www.sagaryukoku.ed.jp/jhsc/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3677,"attribute_key":"feature_description","source_url":"https://www.sagaryukoku.ed.jp/jhsc/education/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-11","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
