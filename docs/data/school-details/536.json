{"id":536,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"社会とつながる探究を行う羽田国際の学び","feature_description":"羽田国際中学校は、持続可能な社会の創り手を育てるESDを基盤に、校訓・教育目標と結び付けた独自のWINGSプログラムを展開します。専門的な学びに加え、探究活動、フィールドワーク、ボランティアを通じて社会と関わり、自分にできることを考えて行動する力を養います。グローカルキャリア教育として、国際的な視野と地域に根ざした課題意識を往復しながら、主体性と創造性を育てる点が特徴です。","clubs":[],"profile_sources":[{"id":1828,"attribute_key":"religious_background","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=154","source_kind":"nichinoken","external_school_code":"154","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1829,"attribute_key":"uniform_policy","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=154","source_kind":"nichinoken","external_school_code":"154","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1830,"attribute_key":"high_school_progression","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=154","source_kind":"nichinoken","external_school_code":"154","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":1831,"attribute_key":"international_programs","source_url":"https://www.nichinoken.co.jp/np5/schoolinfo/sw/index.php?shl_code=154","source_kind":"nichinoken","external_school_code":"154","verified_at":"2026-08-05","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3394,"attribute_key":"feature_summary","source_url":"https://www.kanno.ac.jp/haneda/jhs/education/index.php","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-07","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":3395,"attribute_key":"feature_description","source_url":"https://www.kanno