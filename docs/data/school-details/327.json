{"id":327,"education_philosophy":null,"history":null,"facilities":null,"feature_summary":"誠実明朗と両立で伸びる智辯学園","feature_description":"智辯学園中学校・高等学校は、『愛のある教育』を原点に、『誠実・明朗』で心豊かな人物を育てる学校です。学力の徹底的な錬成に加え、部活動や学校生活を通して人間性を磨きます。普通コースでは、勉学と部活動の両立を目指す姿勢が明確に示されています。公式サイトの学校案内や教育ページが整理され、学びの方針と学校生活の両面を確認しやすいです。","clubs":[{"id":5633,"name":"硬式野球部","category":"運動部","source_url":"https://www.chiben.ac.jp/gojo/category/club/","verified_at":"2026-08-06"},{"id":5634,"name":"剣道部","category":"運動部","source_url":"https://www.chiben.ac.jp/gojo/category/club/","verified_at":"2026-08-06"},{"id":5635,"name":"写真新聞部","category":"文化部","source_url":"https://www.chiben.ac.jp/gojo/category/club/","verified_at":"2026-08-06"}],"profile_sources":[{"id":2964,"attribute_key":"feature_summary","source_url":"https://www.chiben.ac.jp/gojo/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null},{"id":2965,"attribute_key":"feature_description","source_url":"https://www.chiben.ac.jp/gojo/about/","source_kind":"official_site","external_school_code":null,"verified_at":"2026-08-06","source_excerpt":null,"fetched_at":null,"content_hash":null,"invalidated_at":null,"priority":null}]}
